#!/bin/bash
# boxd-pod: sshd ForceCommand of the build account (BOXD_USER), and the reaper the boxd service runs. One long-lived
# rootless podman container or microsandbox virtual machine ("box") per agent worktree. Contract: docs/pod-contract.md.
# The client's words are split on spaces only and never reach a shell: every word is a fixed keyword or
# matches a strict pattern, and the agent's command is one base64 word decoded into an argument list.
set -u
set -f   # no globbing of client words
CONF=${BOXD_CONF:-/etc/boxd/boxd.conf}
[ -r "$CONF" ] && . "$CONF"
WORK=${BOXD_WORK:-/var/lib/boxd/work}
LIMITS=${BOXD_LIMITS:---memory 12g --memory-swap 16g --pids-limit 4096 --cpu-shares 1024}
VM_LIMITS=${BOXD_VM_LIMITS:--c 4 -m 8G}
# Optional ceiling on running machines (unset: none). Admission is by measured memory of the build cgroup (see vm_mem).
# BOXD_CGROUP is that cgroup's folder (a setting: the packaged boxd.conf of systemd hosts names the boxd-sshd unit's own
# cgroup, Void keeps /sys/fs/cgroup/boxd). BOXD_CGROOT (also read by the boxd-sshd service script) is a test hook: a folder
# holding a fake boxd cgroup. Without readable files the count rule applies with a limit of 3.
VM_MAX=${BOXD_VM_MAX:-}
CGROOT=${BOXD_CGROOT:-/sys/fs/cgroup}
CGROUP=${BOXD_CGROUP:-$CGROOT/boxd}
PROC=${BOXD_PROC:-/proc}   # test hook, like BOXD_MEMINFO: where `pod report` finds a box's process and its cgroup
KVM=${BOXD_KVM:-/dev/kvm}   # test hook: the device a --kvm box gets
ROUTE=${BOXD_ROUTE:-/proc/net/route}   # test hooks: the routing table and the network interface folder `pod report` reads
NETDIR=${BOXD_NET:-/sys/class/net}
VERSION=0.4.62
# Keys that may only read, one "<type> <key> [comment]" per line (view_only below); and the largest answer of pod calls and pod log.
VIEW_KEYS=${BOXD_VIEW_KEYS:-/etc/boxd/view_keys}
READ_MAX=${BOXD_READ_MAX:-1048576}
# Docker and podman inside a vm need their own disks: the guest root is an overlay, and neither engine can stack
# its overlay on one (docker fell back to the slow vfs driver, podman refused: "overlay is not supported over
# overlayfs"). Owned disks are sparse ext4 images in MSB_HOME (under the work area) and go away with the box.
VM_ENGINE_DISK=${BOXD_VM_ENGINE_DISK:-32G}
# The guest root has about 4G free; /tmp gets its own sparse disk so tools that check free space (or write large
# temporary files) find room without settings. Unused space costs nothing on the host.
VM_TMP_DISK=${BOXD_VM_TMP_DISK:-64G}
# The engine gives each host folder mounted into a machine a quota of 4G when none is named, and a write past it fails with
# "No space left on device": /job and /cache are named larger (a quota is only a limit, unused space costs nothing).
VM_JOB_DISK=${BOXD_VM_JOB_DISK:-64G}
VM_CACHE_DISK=${BOXD_VM_CACHE_DISK:-64G}
# Home-network services a vm box may reach besides the public internet (microsandbox blocks the home network by
# default). Admin setting only, never from the client: words <address or address/bits>:<tcp|udp>:<port or a-b>.
VM_NET_ALLOW=${BOXD_VM_NET_ALLOW:-}
CLEAN=${BOXD_POD_CLEAN:-/run/boxd-pod.clean}   # exists once this boot's sandboxes were cleared
TTL=${BOXD_TTL:-1800}
DEFAULT_IMAGE=${BOXD_IMAGE:-docker.io/library/debian:stable-slim}
REGISTRIES=${BOXD_REGISTRIES:-docker.io ghcr.io}   # registries a box image may come from (words, no patterns)
IMAGES=${BOXD_IMAGES_DIR:-/var/lib/boxd/images}   # archives of local images (localhost/<name>), made by images-build.sh
BOX_RE='^[a-z0-9][a-z0-9_.-]{0,62}$'
# --env names: credentials only. The value is set in this process's environment just before the command runs (the
# engines read a bare -e NAME from there), so a name must never be one that changes how podman, msb or the loader
# behave on the host (PATH, LD_PRELOAD, ...): no such variable ends in these words.
SECRET_RE='^[A-Z][A-Z0-9_]{0,62}_(TOKEN|KEY|SECRET|PASSWORD)$'
RUN_RE='^[A-Za-z0-9_.-]{1,64}$'
B64_RE='^[A-Za-z0-9+/]+={0,2}$'
LINE_RE='^[A-Za-z0-9_.:/=+,@~ -]+$'

# One line per pod run in $WORK/cache/calls.log (tab separated): start (microseconds since 1970; digits only, the
# decimal separator of EPOCHREALTIME follows the locale, a comma in Italian), box, engine,
# lock wait ms, exit code or "detached", duration ms, refusal message (exit 125, or 75 for no room), run id of a detached run,
# command (the decoded words joined by spaces, control characters and tabs as spaces, the first 200 characters; empty before
# the command is decoded). Read by the usage monitor (the first seven columns, the reason last: readers split on tabs and
# ignore extra fields) and by `pod calls`.
CALL_T0="" CALL_BOX="" CALL_ENGINE="" CALL_WAIT=0 CALL_RUN="" CALL_CMD=""
logcall() {
    [ -n "$CALL_T0" ] && [ -d "$WORK/cache" ] || return 0   # no cache folder yet: nothing to log into
    local now=${EPOCHREALTIME//[!0-9]/}
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$CALL_T0" "$CALL_BOX" "$CALL_ENGINE" "$CALL_WAIT" "$1" \
        "$(( (now - CALL_T0) / 1000 ))" "${2:-}" "$CALL_RUN" "$CALL_CMD" >>"$WORK/cache/calls.log" 2>/dev/null || true
}
die() { echo "boxd-pod: $*" >&2; logcall 125 "$*"; exit 125; }
# No room is its own exit code, so a client can tell "nothing ran, try another host" from a refusal (125) and from the
# command's own code (it also checks the message). 75 is EX_TEMPFAIL of sysexits.h: temporary failure, try again.
noroom() { echo "boxd-pod: $*" >&2; logcall 75 "$*"; exit 75; }

# msb needs HOME and its state folder, short because it holds sockets; @cache keeps images over a plain reset.
export HOME=${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)} MSB_HOME=$WORK/cache/msb
# Every msb call: microsandbox refuses a state folder created under umask 002.
vmx() ( umask 022; [ -d "$MSB_HOME" ] || mkdir -p "$MSB_HOME"; exec msb "$@" )
# vm_rm <sandbox>: removes it. The engine prints its own "Removed" line on standard error; that line is not the caller's.
# A failed removal gives the caller the engine's output in one clear line and returns 1.
vm_rm() { local o; o=$(vmx rm -f "$1" </dev/null 2>&1) || { echo "boxd-pod: removing $1 failed: $o" >&2; return 1; }; }
# vm_mem: sets used_mb (anonymous and shared memory of the build cgroup: guest memory is anonymous memory of the msb
# process, file cache is reclaimable and does not count; plus its swapped-out memory, still in use, which anon no longer
# shows: on 2026-11-15 the tower's group read 23713 MB with 7.7 GB more in swap and kept admitting machines) and cap_mb
# (its memory.max, MemTotal when that is "max"). Fails when the cgroup files cannot be read.
vm_mem() {
    local k v anon="" shm=0 swp=0 cap
    [ -r "$CGROUP/memory.stat" ] && read -r cap <"$CGROUP/memory.max" 2>/dev/null || return 1
    while read -r k v; do case $k in anon) anon=$v ;; shmem) shm=$v ;; esac; done <"$CGROUP/memory.stat"
    [ -r "$CGROUP/memory.swap.current" ] && read -r swp <"$CGROUP/memory.swap.current"   # absent: a kernel without swap accounting
    [[ $anon =~ ^[0-9]+$ && $shm =~ ^[0-9]+$ && $swp =~ ^[0-9]+$ ]] || return 1
    if [ "$cap" = max ]; then
        while read -r k v _; do [ "$k" = MemTotal: ] && cap=$((v * 1024)); done </proc/meminfo
    fi
    [[ $cap =~ ^[0-9]+$ ]] || return 1
    used_mb=$(((anon + shm + swp) / 1048576)) cap_mb=$((cap / 1048576))
}
# Sandbox names are pod-<box> as for containers. "msb ls" can list a box whose machine died, and the next
# exec restarts it silently, so running means listed as running AND a machine process exists.
vm_alive() { pgrep -f "(^|/)msb machine --name $1( |\$)" >/dev/null; }
# Kills by the kernel's out-of-memory killer of processes in the build cgroup so far (memory.events counts the whole subtree,
# also the host-wide kills); 0 when unreadable.
oom_kills() { local a b n=0; { while read -r a b; do [ "$a" = oom_kill ] && n=$b; done <"$CGROUP/memory.events"; } 2>/dev/null; echo "$n"; }
# vm_end_note <sandbox> <box> <oom kills before the command>: one line when the machine is gone after a command in it ended,
# naming the killer when it struck meanwhile (2026-11-15: the tower's kernel killed a machine under three detached runs,
# whose logs said only "exec session ended without exit event"). Nothing while the machine lives.
vm_end_note() {
    vm_alive "$1" && return 0
    if [ "$(oom_kills)" -gt "$3" ]; then
        echo "boxd: the virtual machine of box $2 ended under this run: the host's out-of-memory killer ended a process of the boxes meanwhile (kernel log: dmesg)"
    else
        echo "boxd: the virtual machine of box $2 ended under this run"
    fi
}
# ctr_end_note <box> <oom kills before the command> <exit code>: one line when a command in a container box ended with 137
# (SIGKILL) while the kill counter rose: the kernel's out-of-memory killer took it (the same words as vm_end_note).
ctr_end_note() {
    [ "$3" = 137 ] && [ "$(oom_kills)" -gt "$2" ] || return 0
    echo "boxd: the command in box $1 was killed (exit 137): the host's out-of-memory killer ended a process of the boxes meanwhile (kernel log: dmesg)"
}
# "<sandbox> <image> <running|stopped>" per line, tab separated.
vm_rows() {
    local out n img st
    out=$(vmx ls </dev/null 2>/dev/null) || die "msb ls failed"   # its remark on an empty host ("No sandboxes found.") is not ours to pass on
    while read -r n img st _; do
        [[ $n == pod-* ]] || continue
        [ "$st" = running ] && vm_alive "$n" || st=stopped
        printf '%s\t%s\t%s\n' "$n" "$img" "$st"
    done <<<"$out"
}
# "<image> <state>" of one sandbox, failure when it does not exist.
vm_inspect() {
    local out img st
    out=$(vmx inspect "$1" </dev/null 2>/dev/null) || return 1
    img=$(awk 'tolower($1) == "image:" { sub(/^[^:]*: */, ""); print; exit }' <<<"$out")
    st=$(awk 'tolower($1) == "status:" { sub(/^[^:]*: */, ""); print; exit }' <<<"$out")
    [ "$st" = running ] && vm_alive "$1" || st=stopped
    echo "$img $st"
}

# Run before every command in a vm box. Output and exit code are ignored.
# 1. Drop the guest's cached file-name lookups: rsync replaces files by renaming a new copy over the old one, and
#    the guest kept resolving the old, deleted file through the shared folder (cat: No such file or directory).
#    File contents stay cached. 2. A box with dockerd always has a daemon running.
# safe.directory: the guest's root is not the owner of the synced files (the mirror of the build account's ids), and git refuses a
# repository (--git, --snapshot) owned by another account; this trusts the one folder, inside the machine only (a container's
# root or --user account owns the files there).
DOCKER_START='echo 2 > /proc/sys/vm/drop_caches 2>/dev/null
chmod 1777 /tmp 2>/dev/null
command -v git >/dev/null 2>&1 && git config --system --replace-all safe.directory /job/src 2>/dev/null
command -v dockerd >/dev/null 2>&1 || exit 0
p=$(cat /var/run/docker.pid 2>/dev/null) && kill -0 "$p" 2>/dev/null && exit 0
rm -f /var/run/docker.pid /var/run/docker.sock
setsid dockerd >>/job/runs/dockerd.log 2>&1 </dev/null &
p=$!
while kill -0 "$p" 2>/dev/null && [ ! -S /var/run/docker.sock ]; do sleep 0.1; done'

# Run once when a machine is created or started (its limit does not survive a stop), before DOCKER_START. The guest kernel
# microsandbox boots is built small (6.12.117 logs "pid_max: default: 4096 minimum: 301"): 4096 numbers for all processes and
# threads, and a failed fork looks like a container lost with memory to spare (measured 2026-11-16: 4300 background processes
# died with "Cannot fork"). 32768 is accepted as root and ran 6000 processes; 4194304 is refused, so it is this kernel's ceiling.
# A guest that refuses or lacks the file keeps its limit, silently.
GUEST_PID_MAX='{ echo 32768 > /proc/sys/kernel/pid_max; } 2>/dev/null'

# The account number of a machine made with --user (uid and gid), one for every machine.
VM_UID=1000

# --user in a machine: the owner of the files is the mount, not a step. The two mounts of such a machine are made with uid=<N>,gid=<N>
# (VM_UID, fixed at creation, see pod_run): the guest shows every file under /job and /cache, also one a later sync wrote, as that
# owner, and the host's owner stays the build account (measured 2026-11-17, microsandbox 0.7.15). So nothing is changed per file.
# This script runs as root in the guest before every command of such a machine ($1 is VM_UID) and prints the account's name:
# 0. (not here) the home is made on the host by the caller: a folder made by the guest's root shows as root's under the mounts and the
# account could not write it. Homes that machines of 0.4.28 to 0.4.30 made that way are handed over here, once: only when the home's
# owner (stat -c %u) is not the number, one chown -R of the home, never of /job/src or /cache. 1. the account with that uid: the one the image already has, whatever its name, or else "box" is made (a group with that gid is
# used when the image has one, else made; home /job/home); no groupadd, no useradd, or one that fails, ends with status 3 and the call is
# refused, never run as root; 2. member of docker when that group exists and it is not yet; 3. dmesg opens for every account, so the
# kernel's kill lines of a detached run (GUEST_KILLS) still come when the command runs as the account. The command is given
# HOME=/job/home by the caller, whatever home the account has. BOXD_GUEST_JOB, BOXD_GUEST_ETC and BOXD_GUEST_DMESG are test hooks.
# No single quote in the text: it is a sh -c argument that tests also eval.
GUEST_USER=': boxd-user-setup
j=${BOXD_GUEST_JOB:-/job}; e=${BOXD_GUEST_ETC:-/etc}; i=$1; n= g=
while IFS=: read -r a _ b _; do [ "$b" != "$i" ] || [ -n "$n" ] || n=$a; done <"$e/passwd"
if [ -z "$n" ]; then
  command -v useradd >/dev/null 2>&1 || exit 3
  while IFS=: read -r a _ b _; do [ "$b" != "$i" ] || g=1; done <"$e/group"
  [ -n "$g" ] || groupadd -g "$i" box >/dev/null 2>&1 || exit 3
  useradd -M -u "$i" -g "$i" -d "$j/home" -s "$(command -v bash || echo /bin/sh)" box >/dev/null 2>&1 || exit 3
  n=box
fi
case $n in ""|*[!A-Za-z0-9_.-]*) exit 3 ;; esac
[ "$(stat -c %u "$j/home" 2>/dev/null)" = "$i" ] || chown -R "$i:$i" "$j/home" >/dev/null 2>&1
case " $(id -nG "$n" 2>/dev/null) " in *" docker "*) ;; *) ! getent group docker >/dev/null 2>&1 || usermod -aG docker "$n" >/dev/null 2>&1 || : ;; esac
{ echo 0 >"${BOXD_GUEST_DMESG:-/proc/sys/kernel/dmesg_restrict}"; } 2>/dev/null
echo "$n"'

# The real memory need of a machine, measured where it is known (2026-11-17): the host sees a machine use its whole size, because the guest
# fills spare memory with file cache and never gives it back. This loop runs in the guest while the machine lives and keeps the highest
# MemTotal - MemAvailable (megabytes) in /job/.mem-peak: the box's folder, which the host reads and the sync (only /job/src) never
# touches. The file is written only when the value grows, through a temporary file and a rename, so a reader never sees half a number;
# an older value in the file (an earlier machine of the same box) is the start, so the peak only grows. A guest without sleep, without
# /proc/meminfo or without the memory word MemAvailable ends the loop at once and records nothing. The words BOXD_GUEST_* are the test hooks
# (the file of memory facts, the number of rounds, the pause in seconds); in a guest they are unset. No single quote in the text: the
# starter below puts it inside single quotes.
GUEST_MEM_PEAK='command -v sleep >/dev/null 2>&1 || exit 0
f=${BOXD_MEM_PEAK_FILE:-/job/.mem-peak}; r=${BOXD_GUEST_ROUNDS:-}
echo $$ >"${BOXD_MEM_PEAK_PID:-/run/boxd-mem-peak.pid}" || exit 0
p=$(cat "$f" 2>/dev/null); case $p in ""|*[!0-9]*) p=0 ;; esac
while :; do
  t= a=
  while read -r k v _; do case $k in MemTotal:) t=$v ;; MemAvailable:) a=$v ;; esac; done <"${BOXD_GUEST_MEMINFO:-/proc/meminfo}"
  [ -n "$t" ] && [ -n "$a" ] || exit 0
  case "$t$a" in *[!0-9]*) exit 0 ;; esac
  u=$(((t - a) / 1024))
  if [ "$u" -gt "$p" ]; then p=$u; echo "$p" >"$f.$$" && mv "$f.$$" "$f"; fi
  [ -z "$r" ] || { r=$((r - 1)); [ "$r" -gt 0 ] || exit 0; }
  sleep "${BOXD_GUEST_NAP:-3}"
done'
# Starts the loop once per machine: the pid file names it, and a process of that number counts only when its command line carries the
# marker (a stale file from before a restart may name another process). Output closed and its own session, as dockerd below, so the call
# that starts it returns at once and the loop is not a process of the call. Run before every command with the rest of the start script.
GUEST_MEM_START="MP='$GUEST_MEM_PEAK'"'
p=$(cat "${BOXD_MEM_PEAK_PID:-/run/boxd-mem-peak.pid}" 2>/dev/null)
case $(tr "\000" " " 2>/dev/null <"/proc/${p:-x}/cmdline") in
*boxd-mem-peak*) ;;
*) setsid sh -c "$MP" boxd-mem-peak </dev/null >/dev/null 2>&1 & ;;
esac'

# Runs the command of a detached run inside a machine ("$@") and then prints, prefixed, the guest kernel's kill lines that
# came after it started (2026-11-15 and 2026-11-16: a docker container of a run died in a 4 GB machine, the host killed
# nothing and the guest's kernel log went with the machine). "After it started" is a count, not a clock: the matching lines
# of the kernel log before, then only the lines past that count. The exit code is the command's. A guest without dmesg (the
# plain Void image, seen on the tower on 2026-11-16: the lines never came) reads the kernel's own device, each record without
# its "level,sequence,time;" head; a guest where neither can be read counts and prints nothing.
# shortcut: a kernel log buffer that wrapped during the run shifts the count and may repeat an old line, when that shows: read /dev/kmsg sequence numbers.
GUEST_KILLS='k() { if command -v dmesg >/dev/null 2>&1; then dmesg; else dd if="${BOXD_KMSG:-/dev/kmsg}" iflag=nonblock bs=8192 | sed "s/^[^;]*;//"; fi 2>/dev/null; }
n=$(k | grep -c "Killed process")
"$@"; rc=$?
k | grep "Killed process" | tail -n +$((${n:-0} + 1)) | sed "s/^\[[^]]*\] *//; s/^/[boxd] guest kernel: /"
exit $rc'

# pod ps: run inside the box (container or vm), plain sh and /proc only, so any image works. One line per process,
# oldest first: pid, elapsed seconds, processor seconds, working folder ("?" when unreadable), command. Leaves out
# pid 1, the box's own keep-alive (sleep infinity, catatonit), this script with its helpers (ppid = $$) and the memory loop of
# GUEST_MEM_PEAK with its sleep (the pid file names it).
# /proc times are in clock ticks of 1/100 s on Linux.
PS_SCRIPT='read -r up _ </proc/uptime; up=${up%.*}; o=; m=$(cat "${BOXD_MEM_PEAK_PID:-/run/boxd-mem-peak.pid}" 2>/dev/null)
for d in /proc/[0-9]*; do
  p=${d#/proc/}
  [ "$p" = 1 ] || [ "$p" = $$ ] && continue
  read -r s 2>/dev/null <"$d/stat" || continue   # a process can end mid-scan; 2> first or dash prints the open error
  c=$(tr "\000\n\t" "   " 2>/dev/null <"$d/cmdline"); c=${c% }   # newlines and tabs would break the table
  [ -n "$c" ] || continue
  case $c in "sleep infinity"|"catatonit -P"|catatonit) continue ;; esac
  set -- ${s##*) }
  [ "$2" = $$ ] || [ "$p" = "$m" ] || [ "$2" = "$m" ] && continue
  shift 11; cpu=$(( ($1 + $2) / 100 )); shift 8
  o="$o
$p	$((up - $1 / 100))	$cpu	$(readlink "$d/cwd" 2>/dev/null || echo "?")	$c"
done
[ -z "$o" ] || printf "%s\n" "${o#?}" | sort -t "	" -k2,2nr'

# The cleanup of a foreground call whose session is gone, run inside the box (container or machine) with the call's marker
# as $1. Every process of the call carries BOXD_CALL=<marker> in its environment (pod run sets it): the script finds them
# through the environ file of each process (NUL turned into commas, one line, so the marker is matched as a whole variable),
# sends TERM, waits up to 5 s, then KILL for what remains. Skips pid 1 and itself (its marker is an argument, not in its
# environment). The first word is the fixed tag the contract test's fake engine recognizes.
CALL_KILL=': boxd-call-cleanup; id=$1; scan() { f=0; for d in /proc/[0-9]*; do p=${d#/proc/}; [ "$p" = 1 ] || [ "$p" = $$ ] && continue; case ",$(tr "\000" "," 2>/dev/null <"$d/environ")" in *",BOXD_CALL=$id,"*) f=1; [ -z "$1" ] || kill -"$1" "$p" 2>/dev/null ;; esac; done; }; scan TERM; i=0; while [ "$f" = 1 ] && [ $i -lt 5 ]; do sleep 1; scan; i=$((i + 1)); done; [ "$f" = 0 ] || scan KILL'

# Full image reference, or failure when the registry is not allowed.
norm_image() {
    local r=$1
    [[ $r =~ ^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,199}$ ]] || return 1
    case $r in
        localhost/*)   # a local image: a name and an optional tag, nothing else
            [[ $r =~ ^localhost/[a-z0-9][a-z0-9_.-]{0,62}(:[A-Za-z0-9_.-]{1,64})?$ ]] || return 1
            case $r in *:*) printf %s "$r" ;; *) printf %s:latest "$r" ;; esac
            return ;;
        */*) ;;
        *) printf 'docker.io/library/%s' "$r"; return ;;
    esac
    local reg
    for reg in $REGISTRIES; do
        [ "${r%%/*}" = "$reg" ] && { printf %s "$r"; return; }
    done
    case ${r%%/*} in
        *.*|*:*) return 1 ;;
        *) printf 'docker.io/%s' "$r" ;;
    esac
}

# A localhost/ image missing from the asked engine's own store (boxd-reset all empties both) is loaded from its archive:
# $IMAGES/<name>.tar (made by images-build) or, for images built from an agent's Containerfile, $WORK/cache/images/<name>.tar.
# A third word "force" loads even when the store has the tag: a rebuilt image keeps its tag, the store's copy is stale.
# The machine engine's store is its own and nothing builds into it, so it is stale after a rebuild: the archive it was loaded from
# is recorded (cache/loaded-vm-<checksum of ref>: size and modification time, which a rebuild changes; hashing a 4 GB archive on
# every creation would cost minutes) and an archive that differs from the record, or no record, loads again. podman's store needs
# none of this: images-build builds into it, so it is right whenever it has the tag. The load and the record sit under one lock:
# ensure_image runs before the room lock, and two machines made at once must not both load a 4 GB archive into one store.
ensure_image() {
    local ref=$2 name ar="" d id="" rec=""
    case $ref in localhost/*) ;; *) return 0 ;; esac
    name=${ref#localhost/}; name=${name%%:*}
    for d in "$IMAGES" "$WORK/cache/images"; do [ -r "$d/$name.tar" ] && { ar=$d/$name.tar; break; }; done
    if [ "$1" = vm ] && [ -n "$ar" ]; then
        rec=$WORK/cache/loaded-vm-$(printf %s "$ref" | cksum | cut -d' ' -f1)
        id=$(stat -c %s:%Y "$ar")
        exec 4>"$WORK/cache/image-load.lock"; flock 4
    fi
    if [ "${3:-}" != force ] && image_have "$1" "$ref" && { [ -z "$rec" ] || [ "$(cat "$rec" 2>/dev/null)" = "$id" ]; }; then
        exec 4>&-; return 0
    fi
    [ -n "$ar" ] || die "image $ref is not in storage and $IMAGES/$name.tar is missing; run boxd-setup --images"
    image_load "$1" "$ar" 4>&-
    image_have "$1" "$ref" || die "loading $ar did not give $ref"
    [ "$1" = vm ] || echo "boxd-pod: image $ref was no longer in this host's store; loaded again from its archive" >&2
    [ -z "$rec" ] || printf %s "$id" >"$rec"
    exec 4>&-
}
# The asked engine's own store: has the image, and loads an archive (output and exit code of a failed load are
# ignored: the caller checks that the image is there).
image_have() { if [ "$1" = vm ]; then vmx image inspect "$2" </dev/null >/dev/null 2>&1; else podman image exists "$2"; fi; }
image_load() { if [ "$1" = vm ]; then vmx load <"$2" >/dev/null 2>&1; else podman load -i "$2" </dev/null >/dev/null 2>&1; fi; return 0; }

# pod image has <engine> <ref> <id>: exit 0 when the engine's store has <ref> with image id <id>, 1 otherwise, no output.
# pod image load <engine> <ref> <id>: the archive on standard input (box image push) goes into the engine's store; <ref>
# must be there afterwards. The archive is held in a fresh file under the work area and removed again.
# microsandbox does not report an image's id (its inspect prints only its own digest of the converted image), so for the
# vm store the id of the last pushed archive is recorded in the cache folder and `has` compares with that record.
pod_image() {
    local verb=${1:-} eng=${2:-} ref tmp rc rec
    CALL_T0=${EPOCHREALTIME//[!0-9]/} CALL_BOX=image CALL_ENGINE=$eng
    { { [ "$verb" = has ] || [ "$verb" = load ]; } && [ $# -eq 4 ]; } || die "unknown command"
    [ "$eng" = container ] || [ "$eng" = vm ] || die "bad engine $eng"
    ref=$(norm_image "${3:-}") || die "image not allowed"
    [ "$eng" != vm ] || have_msb || die "virtual machines are not installed on this host"
    [[ $4 =~ ^[a-f0-9]{12,64}$ ]] || die "bad image id"
    rec=$WORK/cache/pushed-vm-$(printf %s "$ref" | cksum | cut -d' ' -f1)
    if [ "$verb" = has ]; then
        if [ "$eng" = vm ]; then image_have vm "$ref" && [ "$(cat "$rec" 2>/dev/null)" = "$4" ]
        else [ "$(podman image inspect --format '{{.Id}}' "$ref" </dev/null 2>/dev/null)" = "$4" ]; fi
        rc=$?; logcall "$rc"; exit "$rc"
    fi
    mkdir -p "$WORK/cache/images" && tmp=$(mktemp "$WORK/cache/images/push.XXXXXX") || die "cannot make a file for the archive"
    trap 'rm -f "$tmp"' EXIT
    cat >"$tmp" || die "cannot store the archive"
    image_load "$eng" "$tmp"
    image_have "$eng" "$ref" || die "loading the archive did not give $ref"
    [ "$eng" != vm ] || printf %s "$4" >"$rec"
    logcall 0; exit 0
}

stamp_of() { stat -c %Y "$WORK/jobs/$1/.last-used" 2>/dev/null || echo 0; }

# Boxes are containers labelled boxd.box and, with an argument, sandboxes named pod-*: "<box> <image> <state> <engine>"
# per line, tab separated. Box name from the container name (pod-<box>): podman 6.1 cannot index .Labels in a ps format.
box_rows() {
    local rows
    rows=$(podman ps -a --filter label=boxd.box --format '{{.Names}}\t{{.Image}}\t{{.State}}') || die "podman ps failed"
    [ -z "$rows" ] || sed 's/^pod-//; s/$/\tcontainer/' <<<"$rows"
    [ -n "${1:-}" ] || return 0
    rows=$(vm_rows) || return 1
    [ -z "$rows" ] || sed 's/^pod-//; s/$/\tvm/' <<<"$rows"
}
have_msb() { command -v msb >/dev/null; }
# Running virtual machines, the box named in $1 (when given) not counted: it is the one asking.
vm_used() {
    local n=0 b st rows
    # The listing is taken first: one that fails must not read as "no machine runs" (the ceiling would admit on it).
    rows=$(vm_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st; do [ -z "$b" ] || [ "$b" = "${1:-}" ] || [ "$st" != running ] || { [ -n "${SKIP_IDLE:-}" ] && vm_idle "$b"; } || n=$((n + 1)); done <<<"$rows"
    echo "$n"
}
# The msb create options of a machine size.
size_lim() { case $1 in small) echo "-c 2 -m 2G" ;; medium) echo "-c 4 -m 4G" ;; xlarge) echo "-c 8 -m 12G" ;; *) echo "$VM_LIMITS" ;; esac; }
# size_for_peak <megabytes>: the smallest of small, medium and large (the host's default, never a larger size: xlarge is the user's choice
# alone) that holds a measured need with a quarter to spare (megabytes of the size at least 1.25 times the need, in whole numbers:
# size * 4 >= need * 5). Prints its name; fails, printing nothing, when even the default does not hold it (a box that is that full keeps its
# recorded size). A size above the default is skipped: a host whose default is below medium never gets a medium machine from this.
size_for_peak() {
    local s mb def
    def=$(lim_mb "$VM_LIMITS"); [[ $def =~ ^[0-9]+$ && ${1:-} =~ ^[0-9]+$ ]] || return 1
    for s in small medium large; do
        mb=$(lim_mb "$(size_lim "$s")")
        [ "$s" = large ] || [ "$mb" -le "$def" ] || continue
        [ $((mb * 4)) -ge $(($1 * 5)) ] && { echo "$s"; return 0; }
    done
    return 1
}
# mem_peak <box folder>: the highest need the guest measured, in megabytes (the file /job/.mem-peak of the guest loop); fails when none is recorded.
mem_peak() { local v; v=$(cat "$1/.mem-peak" 2>/dev/null) && [[ $v =~ ^[1-9][0-9]{0,8}$ ]] && echo "$v"; }
# lim_mb <msb create options>: the memory of a machine made with them, in megabytes; nothing when they name none.
lim_mb() { [[ $1 =~ -m\ ([0-9]+)([MG]) ]] || return 0; [ "${BASH_REMATCH[2]}" = M ] && echo "${BASH_REMATCH[1]}" || echo $((BASH_REMATCH[1] * 1024)); }
# vm_refusal <own sandbox name> <megabytes asked>: why one more machine of that size cannot start now; prints nothing
# when it can. The only place that knows the rule: `pod run` refuses with it and `pod status` reports it (vm_room),
# the client never recomputes it. Measured memory of the build cgroup plus the asked size must fit the cap (vm_mem);
# BOXD_VM_MAX is a ceiling on the count on top, and the only rule (default 3) when the memory cannot be measured.
# The measure alone admits too many: a young machine has not claimed its memory yet (2026-11-15: twelve 4 GB machines
# admitted on a 28 GB cap). So the sizes of the running machines plus the asked size must also fit BOXD_VM_COMMIT
# percent of the cap (100, the default since 0.4.8: no machine can ever push another into the cap; at 150 the tower took
# 36 GB of machines on its 28 GB cap and the kernel killed one, with its runs, on 2026-11-15).
# The measured rule allows 64 MB per running machine other than the asking one on top of the cap: the engine's own memory (2026-11-19:
# one xlarge machine, 12288 MB, measured 12312 to 12326 MB in the cgroup, so a second xlarge was refused on a 24576 MB cap although the
# sizes sum exactly to the cap and the commit rule allows it). The commit rule and vm_never are unchanged.
# shortcut: a fixed 64 MB per machine, when an engine version measures more: read each machine process's memory
VM_COMMIT=${BOXD_VM_COMMIT:-100}
[[ $VM_COMMIT =~ ^[0-9]+$ ]] || die "BOXD_VM_COMMIT must be a number"
# BOXD_BOX_RESERVE (megabytes, default 4096; 0 turns the rule off): container boxes are admitted like machines, by one number. A call
# that starts work in a container box that is not busy is admitted only when the sums that vm_commit and ctr_commit give, plus the
# larger of this reserve and what the box itself uses, fit BOXD_VM_COMMIT percent of the cap (box_fit). A box with a call or run
# that began lately counts at least the reserve in those sums, as a young machine counts its size: it has not claimed its memory yet.
BOX_RESERVE=${BOXD_BOX_RESERVE:-4096}
[[ $BOX_RESERVE =~ ^[0-9]+$ ]] || die "BOXD_BOX_RESERVE must be a number"
# vm_commit <own sandbox name>: prints "<megabytes> <count>": the sizes of the running machines and how many they are, the asking one not counted.
vm_commit() {
    local m=0 k=0 b st rows s
    rows=$(vm_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st; do
        [ -n "$b" ] && [ "$b" != "${1:-}" ] && [ "$st" = running ] || continue
        [ -z "${SKIP_IDLE:-}" ] || ! vm_idle "$b" || continue
        s=$(cat "$WORK/jobs/${b#pod-}/.vm-size" 2>/dev/null); s=$(lim_mb "$(size_lim "${s:-large}")")
        m=$((m + ${s:-0})); k=$((k + 1))
    done <<<"$rows"
    echo "$m $k"
}
# ctr_use <box>: megabytes a running container box uses now (as vm_mem measures: anonymous, shared and swapped memory, no file
# cache). One that cannot be read counts as its whole limit (BOXD_LIMITS --memory); with no limit it fails: never admit on an
# unreadable measure.
ctr_use() {
    local pid v
    pid=$(podman container inspect --format '{{.State.Pid}} {{.Config.Labels}}' "pod-$1" 2>/dev/null) || return 1; pid=${pid%% *}
    v=$(ctr_mb "$pid" used)
    [[ $v =~ ^[0-9]+$ ]] || v=$(ctr_limit_mb)   # unreadable: assume it may use all its limit
    [[ $v =~ ^[0-9]+$ ]] || return 1             # and with no limit either, nothing can be assumed
    echo "$v"
}
# ctr_commit [<own box>]: megabytes the running container boxes count for, the asking box not included. Container boxes have no
# size to reserve, but they grow inside the cap beside the machines (2026-11-15: the build running at the kill was in a
# container box): each counts what ctr_use measures, and a box that is busy with a call or run begun no more than BOXD_VM_IDLE_MIN
# seconds ago counts at least BOXD_BOX_RESERVE, because it has not claimed its memory yet (box_busy, box_young). The one
# computation under the admission of machines (vm_fit) and of container boxes (box_fit).
ctr_commit() {
    local m=0 b st rows v
    rows=$(box_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st _; do
        [ -n "$b" ] && [ "$b" != "${1:-}" ] && [ "$st" = running ] || continue
        v=$(ctr_use "$b") || return 1
        [ "$v" -ge "$BOX_RESERVE" ] || { box_busy "$b" && box_young "$b" && v=$BOX_RESERVE; }
        m=$((m + v))
    done <<<"$rows"
    echo "$m"
}
# box_busy <box>: a run (detached or foreground) or a call holds the box's .running lock (shared), tested without waiting, as the
# reaper does. box_young <box>: its stamp (.last-used, touched when a call begins) is no more than BOXD_VM_IDLE_MIN seconds old,
# the other side of vm_idle.
box_busy() { local f=$WORK/jobs/$1/.running; [ -e "$f" ] && ! flock -n -x "$f" true 2>/dev/null; }
box_young() { [ $(($(date +%s) - $(stamp_of "$1"))) -le "$VM_IDLE_MIN" ]; }
# Idle machines give their room back when another machine asks for it (owner, 2026-11-16: "we really need a way to auto-cleanup
# the idle vms"; an idle 8 GB machine held a slot on a full host until the reaper's 30 minutes). vm_idle <sandbox>: unused for
# BOXD_VM_IDLE_MIN seconds (300), not being made and with no run or call in it: the reaper's own two locks, so a run in flight
# is never touched. With SKIP_IDLE set, vm_used and vm_commit leave such machines out: `pod status` answers with the room they
# would give. shortcut: the measured memory still holds what idle machines use, so `pod status` can say no where `pod run`
# would make room; upgrade by measuring each machine when that is seen. queue_fits (the waiting line's yes) answers yes in that case too
# (since 0.4.60): when the only rule left is the measured one and another machine is idle, `pod run` removes it.
VM_IDLE_MIN=${BOXD_VM_IDLE_MIN:-300}
[[ $VM_IDLE_MIN =~ ^[0-9]+$ ]] || die "BOXD_VM_IDLE_MIN must be a number"
vm_idle() {
    local J=$WORK/jobs/${1#pod-}
    [ -d "$J" ] && [ $(($(date +%s) - $(stamp_of "${1#pod-}"))) -gt "$VM_IDLE_MIN" ] || return 1
    ( exec 9>"$J/.lock"; flock -n 9 || exit 1; [ ! -e "$J/.running" ] || flock -n -x "$J/.running" true )
}
# vm_evict_idle <own sandbox name>: removes the idle machine unused the longest (its folder stays, as after the reaper; its next
# call makes it again) and logs it where `pod report` reads removals. Fails when there is none.
vm_evict_idle() {
    local b st rows best="" bt=0 t
    rows=$(vm_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st; do
        [ -n "$b" ] && [ "$b" != "${1:-}" ] && [ "$st" = running ] && vm_idle "$b" || continue
        t=$(stamp_of "${b#pod-}"); [ -n "$best" ] && [ "$t" -ge "$bt" ] || { best=$b bt=$t; }
    done <<<"$rows"
    [ -n "$best" ] || return 1
    (   # the locks again, held over the removal: it may have been called since the look
        J=$WORK/jobs/${best#pod-}; exec 9>"$J/.lock"; flock -n 9 || exit 1
        [ ! -e "$J/.running" ] || flock -n -x "$J/.running" true || exit 1
        vmx rm -f "$best" </dev/null >/dev/null 2>&1   # the engine's own "Removed" line went into the caller's output (seen on laptop, 2026-11-16)
    ) || return 1
    echo "boxd-pod: the idle machine of box ${best#pod-} was removed to make room for this one" >&2
    printf '%s\t%s\t%s\n' "$(date +%s)" "${best#pod-}" "idle machine removed, ${1#pod-} asked for room" >>"$WORK/cache/evictions.log" 2>/dev/null || true
}
# vm_has_idle <own sandbox name>: succeeds when some other running machine is idle (vm_idle), so that vm_evict_idle has one to remove.
vm_has_idle() {
    local b st rows
    rows=$(vm_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st; do
        [ -n "$b" ] && [ "$b" != "${1:-}" ] && [ "$st" = running ] && vm_idle "$b" && return 0
    done <<<"$rows"
    return 1
}
# vm_calm: succeeds when a running machine has no run or call in it (not busy): one that was too young to be removed above.
vm_calm() {
    local b st rows
    rows=$(vm_rows 2>/dev/null) || return 1
    while IFS=$'\t' read -r b _ st; do [ "$st" = running ] && ! box_busy "${b#pod-}" && return 0; done <<<"$rows"
    return 1
}
# vm_fit <own sandbox name> <megabytes asked> [all]: the one computation behind that rule. Sets fit_mb (the largest machine
# `pod run` admits now, in megabytes: the smaller of the cap minus the measured use and the commit share minus the running
# machines minus the container boxes' use, never below 0; 0 at the count ceiling; a dash when the memory cannot be measured or
# counted, then only the count rule exists) and fit_why (why the asked size is refused, empty when it fits). Without `all` it
# stops at the first refusal, as `pod run` always did (no listings it does not need under the room lock); `pod status` passes
# `all` for both words in one pass (2026-11-16: a --size medium user was told "no room" from the answer for the default size).
vm_fit() {
    local n max=$VM_MAX used_mb cap_mb com ctr cm="" a=${2:-} f c ov=0 cn cok=
    fit_mb=- fit_why=
    if [ -n "$a" ] && vm_mem; then
        # The count of running machines is needed first, for the allowance (shortcut: see the header above).
        if com=$(vm_commit "${1:-}"); then cok=1; cn=${com#* }; com=${com% *}; ov=$((64 * cn)); fi
        f=$((cap_mb + ov - used_mb))
        [ $((used_mb + a)) -le $((cap_mb + ov)) ] || { fit_why="$used_mb MB in use + $a MB asked > $cap_mb MB cap"; [ -n "${3:-}" ] || return 0; }
        if [ -n "$cok" ]; then
            if ctr=$(ctr_commit); then
                c=$((cap_mb * VM_COMMIT / 100 - com - ctr)); [ "$c" -ge "$f" ] || f=$c
                fit_mb=$((f > 0 ? f : 0))
                [ "$ctr" = 0 ] || cm="$ctr MB used by container boxes + "
                # The container term shows only when there is one, so the message of a host without container memory stays as it was.
                [ -n "$fit_why" ] || [ $((com + ctr + a)) -le $((cap_mb * VM_COMMIT / 100)) ] ||
                    fit_why="$com MB of running machines + $cm$a MB asked > $((cap_mb * VM_COMMIT / 100)) MB, $VM_COMMIT% of the $cap_mb MB cap"
            else [ -n "$fit_why" ] || fit_why="the running container boxes cannot be measured now"; fi
        else [ -n "$fit_why" ] || fit_why="the running machines cannot be counted now"; fi
        [ -z "$fit_why" ] || [ -n "${3:-}" ] || return 0
    else max=${max:-3}; fi
    [ -n "$max" ] || return 0
    n=$(vm_used "${1:-}") || { [ -n "$fit_why" ] || fit_why="the running machines cannot be counted now"; return 0; }
    [ "$n" -lt "$max" ] || { fit_mb=0; [ -n "$fit_why" ] || fit_why="$n of $max running"; }
}
# vm_never <size word> <megabytes asked>: when the asked machine alone is larger than the host could ever give (the cap, or the commit
# share of it when that is smaller, with nothing else running), prints the final refusal; nothing when it can fit or the cap is unknown.
vm_never() {
    local used_mb cap_mb b; [[ ${2:-} =~ ^[0-9]+$ ]] && vm_mem || return 0
    b=$((cap_mb * VM_COMMIT / 100)); [ "$b" -le "$cap_mb" ] || b=$cap_mb
    [ "$2" -le "$b" ] || echo "a machine of size ${1:-default} ($2 MB) never fits this host: its cap is $b MB; use a smaller --size here or another host"
}
vm_refusal() { local fit_mb fit_why; vm_fit "$@"; [ -z "$fit_why" ] || echo "$fit_why"; }
# Room for one more machine of the default (large) size.
vm_room() { [ -z "$(vm_refusal "${1:-}" "$(lim_mb "$VM_LIMITS")")" ]; }
# box_fit <own box> [kept]: the admission of a call that starts work in a container box that is not busy
# (pod run), by the sums of vm_commit and ctr_commit. Sets box_fit_mb (what one more busy box may claim: BOXD_VM_COMMIT percent of
# the cap minus those sums, never below 0; a dash when the rule is off or the memory cannot be measured or counted, then only
# today's rule exists: the cap of the whole group) and box_why (why the call is refused, empty when it fits: the sums plus the
# larger of the reserve and the box's own use must fit; with a second word the own box is running and kept, and its use is measured).
# `pod status` asks with no own box (box_room, box_fit_mb).
box_fit() {
    local com=0 ctr used_mb cap_mb lim own=0 need
    box_fit_mb=- box_why=
    [ "$BOX_RESERVE" -gt 0 ] && vm_mem || return 0
    { ! have_msb || { com=$(vm_commit) && com=${com% *}; }; } && ctr=$(ctr_commit "${1:-}") || return 0
    lim=$((cap_mb * VM_COMMIT / 100))
    [ -z "${2:-}" ] || own=$(ctr_use "$1") || own=0
    need=$BOX_RESERVE; [ "$own" -le "$need" ] || need=$own
    box_fit_mb=$((lim > com + ctr ? lim - com - ctr : 0))
    [ "$box_fit_mb" -ge "$need" ] || box_why="$((com + ctr)) MB counted + $need MB reserve > $lim MB, $VM_COMMIT% of the $cap_mb MB cap"
}

# The waiting line (docs/pod-contract.md): a call made with --queued (the client's --wait) that is refused for room leaves a ticket
# in cache/queue, a folder of the build account that no box mounts: "<epoch of the first ask> vm <megabytes>" or "<epoch> box"; its
# modification time is the last ask. A ticket is live when that was no more than BOXD_QUEUE_LIVE seconds ago (120: four asks of the
# client's 30 seconds). All of it is read and written under the room lock (vm-room.lock), so two callers cannot both pass.
QUEUE_LIVE=${BOXD_QUEUE_LIVE:-120}
[[ $QUEUE_LIVE =~ ^[0-9]+$ ]] || die "BOXD_QUEUE_LIVE must be a number"
QUEUE=$WORK/cache/queue
# queue_live [sweep]: the live tickets, oldest first, "<first ask> <box> <need>" per line; with sweep the dead ones are removed (under
# the room lock only). Run it inside $( ): it switches globbing on for the folder.
queue_live() {
    local f t need now
    now=$(date +%s); set +f
    for f in "$QUEUE"/*; do
        [ -f "$f" ] || continue
        t= need=; read -r t need <"$f" 2>/dev/null
        if [[ $t =~ ^[0-9]+$ ]] && [ $((now - $(stat -c %Y "$f" 2>/dev/null || echo 0))) -le "$QUEUE_LIVE" ]; then printf '%s %s %s\n' "$t" "${f##*/}" "$need"
        else [ "${1:-}" != sweep ] || rm -f "$f"; fi
    done | sort -k1,1n -k2,2
}
hhmm() { date -d "@$1" +%H:%M; }
# join_max <max> <items...>: the items joined by ", ", past max the rest as " and <n> more".
join_max() {
    local max=$1 s="" n i; shift; n=$#
    for ((i = 1; i <= n && i <= max; i++)); do s+="${s:+, }${!i}"; done
    [ "$n" -le "$max" ] || s+=" and $((n - max)) more"
    printf %s "$s"
}
# queue_look <box>: sets q_first (when this box first asked: its own live ticket, else now) and q_ahead (the live tickets of other boxes
# older than that, oldest first, one per line; all of them when this box has no ticket). Sweeps the dead ones.
queue_look() {
    local t b need
    q_first=$(date +%s) q_ahead=
    while read -r t b need; do
        [ -n "$b" ] || continue
        [ "$b" != "$1" ] || { q_first=$t; break; }
        q_ahead+="$t $b $need"$'\n'
    done <<<"$(queue_live sweep)"
}
# queue_fits <box> <need>: whether that box's call would be admitted now, by the check a real ask gets (idle machines count as gone, as the
# eviction would make them, but none is removed here).
queue_fits() {
    local box_fit_mb box_why hope
    case $2 in
        # As in pod_run: the measured memory still holds what idle machines use, so that rule alone refusing (with idle machines left
        # out) is a yes while one is idle: pod run removes it. Nothing idle left, or another rule refusing: no.
        vm\ *) hope=$(SKIP_IDLE=1 vm_refusal "pod-$1" "${2#vm }")
            [ -z "$hope" ] || { [[ $hope == *" MB in use + "* ]] && vm_has_idle "pod-$1"; } ;;
        *) ! box_busy "$1" || return 1   # a call into a busy box needs no room
           SKIP_IDLE=1 box_fit "$1"; [ -z "$box_why" ] ;;
    esac
}
# queue_busy <asking box>: the boxes that count against the room, "<box> (since HH:MM)" (the stamp of the box's last call, as far as known).
queue_busy() {
    local rows t b st l=() line
    rows=$(box_rows $(have_msb && echo 1) 2>/dev/null) || rows=
    while read -r line; do t=${line%% *} b=${line#* }; l+=("$b$([ "$t" = 0 ] || echo " (since $(hhmm "$t"))")"); done < <(
        while IFS=$'\t' read -r b _ st _; do
            [ "$st" = running ] && [ "$b" != "$1" ] && box_busy "$b" && printf '%s %s\n' "$(stamp_of "$b")" "$b"
        done <<<"$rows" | sort -n)
    [ ${#l[@]} -gt 0 ] && join_max 4 "${l[@]}" || printf none
}
# room_refused <box> <need> <message>: ends a call that found no room (exit 75). A queued call (pod_run's $queued) also writes or refreshes
# its ticket (the first ask kept) and is told its place and what holds the room.
room_refused() {
    local msg=$3 t b a=() n
    if [ -n "$queued" ]; then
        { mkdir -p "$QUEUE" && printf '%s %s\n' "$q_first" "$2" >"$QUEUE/$1"; } 2>/dev/null || true   # a ticket that cannot be written costs the call its place, not the refusal
        while read -r t b _; do [ -z "$b" ] || a+=("$(hhmm "$t")"); done <<<"$q_ahead"
        n=${#a[@]}
        if [ "$n" = 0 ]; then msg+="; first in line"
        else msg+="; $n call$([ "$n" = 1 ] && echo " waits" || echo "s wait") ahead of this one (since $(join_max 3 "${a[@]}"))"; fi
        msg+="; busy now: $(queue_busy "$1")"
    fi
    noroom "$msg"
}
# queue_gate <box> <need> <what>: nobody takes room an earlier waiter could take at its next ask: refuses a call that needs new room
# (the caller has seen today's check admit it) while a live ticket older than this call's own, or any when it has none, would fit now.
# An earlier waiter that does not fit holds nobody back. Nothing is removed on a ticket's behalf.
queue_gate() {
    local t b need l=() n v
    while read -r t b need; do
        [ -n "$b" ] && queue_fits "$b" "$need" || continue
        l+=("$b since $(hhmm "$t")")
    done <<<"$q_ahead"
    n=${#l[@]}; [ "$n" -gt 0 ] || return 0
    v="calls wait"; [ "$n" != 1 ] || v="call waits"
    room_refused "$1" "$2" "no room for another $3 yet: $n earlier $v for it ($(join_max 3 "${l[@]}")); it is served in turn"
}

# Retention: the host is kept clean by boxd itself, nobody cleans by hand (owner decision 2026-11-14). Only whole box
# folders go, never single files of a box: unused for BOXD_KEEP_DAYS, or the least recently used one per reaper pass
# while the work area is full (from BOXD_EVICT_AT percent until it is under BOXD_EVICT_TO), or the folder of a worktree
# that is gone (`pod drop`, sent by the client's collector). Every removal is one line in cache/evictions.log
# (epoch, box, reason; tab separated) and the next call of that box says it once.
KEEP_DAYS=${BOXD_KEEP_DAYS:-14} EVICT_AT=${BOXD_EVICT_AT:-70} EVICT_TO=${BOXD_EVICT_TO:-60}
for v in "$KEEP_DAYS" "$EVICT_AT" "$EVICT_TO"; do [[ $v =~ ^[0-9]+$ ]] || die "BOXD_KEEP_DAYS, BOXD_EVICT_AT and BOXD_EVICT_TO must be numbers"; done
# Last use of a box folder: its stamp, or its own date when no call stamped it yet (a first sync is under way).
used_of() { stat -c %Y "$WORK/jobs/$1/.last-used" 2>/dev/null || stat -c %Y "$WORK/jobs/$1" 2>/dev/null || echo 0; }
# drop_box <box> <reason> <epoch> [force]: removes the box and its folder. Never while the box is being made (.lock);
# never while a run or a sync holds it (.running), unless forced. Fails (1) when it removed nothing.
drop_box() {
    local box=$1 J=$WORK/jobs/$1 log=$WORK/cache/evictions.log mb pk sz smb need=
    [[ $box =~ $BOX_RE ]] && [ -d "$J" ] || return 1
    (
        exec 9>"$J/.lock"; flock -n 9 || exit 1
        [ -n "${4:-}" ] || [ ! -e "$J/.running" ] || flock -n -x "$J/.running" true || exit 1
        pod_stop "$box" || exit 1
        # The need the machine measured, read when nothing writes it any more; with its size it is the answer's words and a line of mem-peaks.log.
        if pk=$(mem_peak "$J"); then
            sz=$(cat "$J/.vm-size" 2>/dev/null); case $sz in small|medium|xlarge) ;; *) sz=large ;; esac
            smb=$(lim_mb "$(size_lim "$sz")"); smb=${smb:--}
        fi
        # In the account's user namespace: files made by other users inside a box belong to its subordinate ids (only there are they readable, so the size is measured there too).
        # shortcut: the size is the folder's alone, the built image removed below is not counted; when a report needs the image too: read its size before `podman rmi`.
        mb=$(podman unshare du -smx -- "$J" </dev/null 2>/dev/null 9>&- | cut -f1) || mb=
        [[ $mb =~ ^[0-9]+$ ]] || mb=
        podman unshare rm -rf -- "$J" </dev/null 9>&- || exit 1
        rm -rf -- "$WORK/cache/events/$box"   # the event records of its runs (outside the folder the box writes)
        # The image built from the box's Containerfile has no other user (an image that is not there is no error).
        podman rmi "localhost/built-$box:latest" </dev/null >/dev/null 2>&1 9>&-
        ! have_msb || vmx image rm "localhost/built-$box:latest" </dev/null >/dev/null 2>&1 9>&-
        mkdir -p "$WORK/cache" && printf '%s\t%s\t%s\n' "$3" "$box" "$2" >> "$log"
        [ "$(wc -l < "$log")" -le 2000 ] || { tail -n 1000 "$log" > "$log.new" && mv "$log.new" "$log"; }
        # The week of numbers the owner decides from: time, box, size name, size and need (docs/pod-contract.md, "Memory need").
        if [ -n "${pk:-}" ]; then
            log=$WORK/cache/mem-peaks.log; need=", needed $pk MB of $smb MB ($sz)"
            printf '%s\t%s\t%s\t%s\t%s\n' "$3" "$box" "$sz" "$smb" "$pk" >> "$log"
            [ "$(wc -l < "$log")" -le 20000 ] || { tail -n 10000 "$log" > "$log.new" && mv "$log.new" "$log"; }
        fi
        echo "evicted $box ($2)$need${mb:+, $mb MB freed}"
    )
}
# Images: under disk pressure (no argument) every named image goes unless a box uses it (the engines refuse those themselves) or it is
# the built image of a box whose folder is still here; then the dangling layers. With an age (evict_images <days> <now>, the daily pass)
# only an image created before that many days goes, and never a shared image that has an archive in BOXD_IMAGES_DIR (it is loaded
# again only at need and the next box would wait for it). All of them come back by themselves: pulled again, loaded again from
# BOXD_IMAGES_DIR, built again from the Containerfile. An image sent with `box image push` must be pushed again (`pod image has`
# then answers no). GONE counts what the engines removed. In the daily pass an image a box folder records stays too (see kept_images).
# shortcut: an image's age is its creation date, not its last use, so a freshly pulled old image goes when no box uses it; when that costs pulls: a last-use stamp per image.
GONE=0 KEPT=
# <ref> with :latest when it has no tag, the one form both sides of a comparison are brought to (a recorded or listed reference may lack it).
tagged() { case ${1##*/} in *:*) printf %s "$1" ;; *) printf %s:latest "$1" ;; esac; }
# The images the existing box folders record (.kind) and the default image, one per line: a stopped box starts again from its record.
kept_images() {
    local k line
    tagged "$DEFAULT_IMAGE"; echo
    while IFS= read -r k; do   # find, not a pattern: this script runs with set -f
        while IFS= read -r line; do case $line in image=*) tagged "${line#image=}"; echo ;; esac; done <"$k"
    done < <(find "$WORK/jobs" -mindepth 2 -maxdepth 2 -name .kind -type f 2>/dev/null)
}
image_goes() {   # <ref> <created> <days> <now>: 0 when the daily pass may remove it
    local ref=$1 name t
    [[ $ref =~ ^localhost/built-(.+):latest$ ]] && [ -d "$WORK/jobs/${BASH_REMATCH[1]}" ] && return 1
    [ -n "${3:-}" ] || return 0
    case "$KEPT" in *$'\n'"$(tagged "$ref")"$'\n'*) return 1 ;; esac
    case $ref in localhost/*) name=${ref#localhost/}; [ ! -e "$IMAGES/${name%%:*}.tar" ] || return 1 ;; esac
    t=$(date -d "${2% UTC}" +%s 2>/dev/null) && [ $((${4} - t)) -gt $((${3} * 86400)) ]   # no readable date: it stays
}
evict_images() {
    local ref created
    while IFS=$'\t' read -r ref created; do
        [[ $ref == *"<none>"* || -z $ref ]] && continue
        image_goes "$ref" "$created" "${1:-}" "${2:-}" || continue
        ! podman rmi "$ref" </dev/null >/dev/null 2>&1 || GONE=$((GONE + 1))
    done < <(podman images --format '{{.Repository}}:{{.Tag}}\t{{.CreatedAt}}' </dev/null 2>/dev/null)
    [ -n "${1:-}" ] || podman image prune -f </dev/null >/dev/null 2>&1
    have_msb || return 0
    while read -r ref _ _ _ created; do
        [ -n "$ref" ] && [ "$ref" != REFERENCE ] || continue
        image_goes "$ref" "$created" "${1:-}" "${2:-}" || continue
        ! vmx image rm "$ref" </dev/null >/dev/null 2>&1 || GONE=$((GONE + 1))
    done < <(vmx image ls </dev/null 2>/dev/null)
    [ -n "${1:-}" ] || find "$WORK/cache" -maxdepth 1 -name 'pushed-vm-*' -type f -delete
}
# The shared package caches, under disk pressure only: files not written or changed on this host for the retention time go (the time of
# the clock $1 is "now"). The change time, not the modification time: tools keep the upstream's old modification times on what they unpack,
# and all files of one unpacked package are written together, so a folder goes whole, marker included, and the tool fetches it again.
evict_caches() { [ ! -d "$WORK/cache/pod" ] || podman unshare find "$WORK/cache/pod" -type f ! -newerct "@$(($1 - KEEP_DAYS * 86400))" -delete </dev/null 2>/dev/null; }
# The image archives of boxes (cache/images): built-<box>.tar belongs to the box <box> and stays while its folder is here; any
# other archive (a pushed image's temporary file, an agent's own image) cannot be tied to a box, age alone decides.
evict_archives() {
    local f
    find "$WORK/cache/images" -maxdepth 1 -type f -mtime "+$KEEP_DAYS" -printf '%f\n' 2>/dev/null | while IFS= read -r f; do
        [[ $f =~ ^built-(.+)\.tar$ ]] && [ -d "$WORK/jobs/${BASH_REMATCH[1]}" ] && continue
        rm -f -- "$WORK/cache/images/$f" && echo "$f"
    done
}
# The daily pass: at most once in 24 hours by the stamp's own time, the first pass after an install at once. Each kind that
# removed something is one line in evictions.log.
evict_daily() {
    local now=$1 stamp=$WORK/cache/.evicted-daily n
    local age=$((now - $(stat -c %Y "$stamp" 2>/dev/null || echo 0)))
    [ ! -e "$stamp" ] || [ "$age" -ge 86400 ] || [ "$age" -lt 0 ] || return 0   # a stamp from the future (a hand-set date) runs the pass
    touch -d "@$now" "$stamp" || return 0
    n=$(evict_archives | wc -l)
    [ "$n" -eq 0 ] || printf '%s\timage-archives\tolder than %s days, %s files\n' "$now" "$KEEP_DAYS" "$n" >> "$WORK/cache/evictions.log"
    GONE=0 KEPT=$'\n'$(kept_images)$'\n'; evict_images "$KEEP_DAYS" "$now"; KEPT=
    [ "$GONE" -eq 0 ] || printf '%s\timages\tolder than %s days, %s images\n' "$now" "$KEEP_DAYS" "$GONE" >> "$WORK/cache/evictions.log"
    return 0
}
evict() {
    local now=$1 keep=$((KEEP_DAYS * 86400)) list s box pct flag=$WORK/cache/.evicting
    # Not before this boot's clear: removing a box asks microsandbox, which trusts process ids from before the reboot.
    if have_msb && [ ! -e "$CLEAN" ]; then return 0; fi
    [ -d "$WORK/jobs" ] && mkdir -p "$WORK/cache" || return 0
    list=$(find "$WORK/jobs" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | while IFS= read -r box; do
        [[ $box =~ $BOX_RE ]] && printf '%s %s\n' "$(used_of "$box")" "$box"; done | sort -n)
    while read -r s box; do
        [ -n "$box" ] && [ $((now - s)) -gt "$keep" ] || continue
        drop_box "$box" "unused $KEEP_DAYS days" "$now" || true
    done <<<"$list"
    evict_daily "$now"
    pct=$(df --output=pcent "$WORK" 2>/dev/null | tr -dc '0-9\n' | sed -n '$p')
    [[ $pct =~ ^[0-9]+$ ]] || return 0
    if [ "$pct" -ge "$EVICT_AT" ]; then
        if [ ! -e "$flag" ]; then   # once per episode of pressure
            evict_images; evict_caches "$now"
            printf '%s\timages\tdisk %s percent full\n' "$now" "$pct" >> "$WORK/cache/evictions.log"; echo "evicted images (disk $pct percent full)"
        fi
        : > "$flag"
    elif [ "$pct" -lt "$EVICT_TO" ]; then rm -f "$flag"; fi
    [ -e "$flag" ] || return 0
    # One folder per pass: freed space shows up late on btrfs, so the next pass measures again before taking more.
    # A folder used within the box lifetime (BOXD_TTL) is never taken.
    while read -r s box; do
        [ -n "$box" ] && [ -d "$WORK/jobs/$box" ] && [ $((now - s)) -gt "$TTL" ] || continue
        if drop_box "$box" "disk $pct percent full" "$now"; then break; fi
    done <<<"$list"
}
# pod drop <box>: an order, removes the box even under a run. pod drop <box> idle: the collector's guess that nothing runs is not trusted,
# so a box with a run or a call going (.running held) is kept, exit 75 (temporary: asked again at its next pass).
pod_drop() {
    [[ ${1:-} =~ $BOX_RE ]] || die "bad box name"
    [ -z "${2:-}" ] || [ "$2" = idle ] || die "unknown command"
    if [ ! -d "$WORK/jobs/$1" ]; then pod_stop "$1"; return; fi
    if [ "${2:-}" = idle ]; then drop_box "$1" "worktree gone" "$(date +%s)" || noroom "box $1 has a run or a call going; kept"; return; fi
    drop_box "$1" "worktree gone" "$(date +%s)" force || die "box $1 is being made right now; not removed"
}

# The shared package caches of every box (cache/pod, /cache inside): one download serves all boxes of the host, which also
# keeps the host's one public address under the request limits of the package sources.
# BOXD_MAVEN_MIRROR: the address of a caching repository (a repository manager on the home network) that every box's Maven uses
# in place of the public central source; the settings file that says so lives in the shared cache and is this script's to write.
MAVEN_MIRROR=${BOXD_MAVEN_MIRROR:-}
[[ -z $MAVEN_MIRROR || $MAVEN_MIRROR =~ ^https?://[A-Za-z0-9._:/-]+$ ]] || die "bad BOXD_MAVEN_MIRROR"
CACHE_ENV=(-e CARGO_HOME=/cache/cargo -e GOMODCACHE=/cache/go/mod -e GOCACHE=/cache/go/build
    -e npm_config_cache=/cache/npm -e npm_config_store_dir=/cache/pnpm-store -e XDG_CACHE_HOME=/cache/xdg
    -e "MAVEN_ARGS=-Dmaven.repo.local=/cache/m2${MAVEN_MIRROR:+ -s /cache/maven-settings.xml}" -e GRADLE_USER_HOME=/cache/gradle)

reap() {
    local now box J rows engine vmrows=
    now=$(date +%s)
    if [ "${1:-}" = --now ]; then
        [[ ${2:-} =~ ^[0-9]+$ ]] || die "--now needs an epoch"
        now=$2
    fi
    # Sandboxes only after this boot's clear: microsandbox trusts a process id recorded before the reboot.
    if have_msb && [ -e "$CLEAN" ]; then vmrows=1; fi
    rows=$(box_rows $vmrows) || die "listing boxes failed"
    while IFS=$'\t' read -r box _ _ engine; do
        [[ $box =~ $BOX_RE ]] || continue
        [ $((now - $(stamp_of "$box"))) -gt "$TTL" ] || continue
        J=$WORK/jobs/$box
        # Skip a box being created or used right now: .lock is held while it is made, .running by every run.
        (
            if [ -d "$J" ]; then exec 9>"$J/.lock"; flock -n 9 || exit 0; fi
            [ ! -e "$J/.running" ] || flock -n -x "$J/.running" true || exit 0
            if [ "$engine" = vm ]; then vm_rm "pod-$box"; else podman rm -f "pod-$box" </dev/null >/dev/null; fi && echo "reaped $box"
        )
    done <<<"$rows"
    evict "$now"
}

# The listing is made before anything is printed: a pipeline would hide a failed engine call (podman ps, msb ls) and answer the
# other engine's boxes alone, a machine that runs missing from the list. A failure ends the call with exit 125 and its reason
# (box_rows says which engine failed).
pod_list() {
    local box image state engine vmrows= rows
    have_msb && vmrows=1
    rows=$(box_rows $vmrows) || exit 125
    [ -z "$rows" ] || sort <<<"$rows" | while IFS=$'\t' read -r box image state engine; do
        [ "$state" = running ] || state=stopped
        printf '%s\t%s\t%s\t%s\t%s\n' "$box" "$image" "$state" "$(stamp_of "$box")" "$engine"
    done
}

# Processes of a running box, for spotting a hung command (read only: no lock, no last-used stamp, starts nothing).
pod_ps() {
    [[ ${1:-} =~ $BOX_RE ]] || die "bad box name"
    local name=pod-$1 out st
    # The same format as pod run reads: "<image> <state> map[...]".
    if out=$(podman container inspect --format '{{.Config.Image}} {{.State.Status}} {{.Config.Labels}}' "$name" 2>/dev/null); then
        st=${out#* }; st=${st%% *}
        [ "$st" = running ] || { echo "boxd-pod: box $1 is not running" >&2; return 0; }
        podman exec "$name" sh -c "$PS_SCRIPT" </dev/null
    elif have_msb && out=$(vm_inspect "$name"); then
        [ "${out##* }" = running ] ||
            { echo "boxd-pod: virtual machine box $1 is stopped; the next command in it starts it again, when the host has room" >&2; return 0; }
        vmx exec -w / "$name" -- sh -c "$PS_SCRIPT" </dev/null
    else
        die "no box $1"
    fi
}

# One line of facts, tab separated key=value words, for a client choosing among hosts (docs/pod-contract.md). Read only:
# no lock, nothing started, so it is advice; `pod run` under the room lock stays the authority. Memory: the build
# cgroup's limit minus the memory that cannot be given back (anonymous and shared, vm_mem: the figure the admission uses; the
# file cache, active or not, is reclaimable and is not used), in megabytes.
# Host memory facts for `pod status` and `pod report` (one source, so the two agree): meminfo_mb prints "total available swap_total
# swap_used" in megabytes; group_mem sets gmax (the cgroup's limit, a dash for `max` or unreadable) and gcur (what vm_mem counts as
# used, a dash when unreadable) in the caller, which declares used_mb and cap_mb for vm_mem.
meminfo_mb() {
    awk '$1 == "MemTotal:" { t = $2 } $1 == "MemAvailable:" { a = $2 } $1 == "SwapTotal:" { s = $2 } $1 == "SwapFree:" { f = $2 }
        END { printf "%d %d %d %d\n", t / 1024, a / 1024, s / 1024, (s - f) / 1024 }' "${BOXD_MEMINFO:-/proc/meminfo}" 2>/dev/null
}
group_mem() {
    local v
    gmax="-" gcur="-"
    { v=$(<"$CGROUP/memory.max"); } 2>/dev/null && [[ $v =~ ^[0-9]+$ ]] && gmax=$((v / 1048576))
    ! vm_mem || gcur=$used_mb   # the same figure as mem_free_mb: the limit minus this is the free memory
}
pod_status() {
    local eng=container used=0 room=no vmrows="" img="" mem=unknown l1 f vmax=$VM_MAX used_mb cap_mb rows ma gmax gcur why="" fit_mb=- fit_why box_fit_mb box_why box_room=yes
    have_msb && vmrows=1
    rows=$(box_rows $vmrows) || exit 125   # first: a failed listing ends the call before anything else lists
    vm_mem || vmax=${vmax:-3}   # the count rule and its default apply when the memory cannot be measured
    if have_msb; then
        eng=container,vm used=$(vm_used)
        SKIP_IDLE=1 vm_fit "" "$(lim_mb "$VM_LIMITS")" all; why=$fit_why; [ -n "$why" ] || room=yes   # one pass for the words vm_room, vm_why and vm_fit_mb: the same rule as `pod run`
    fi
    SKIP_IDLE=1 box_fit ""; [ -z "$box_why" ] || box_room=no   # the same rule as `pod run` for a container box that is not busy, idle machines left out as for vm_room
    read -r l1 _ </proc/loadavg
    ! vm_mem || mem=$((cap_mb > used_mb ? cap_mb - used_mb : 0))
    while IFS= read -r f; do img=${img:+$img,}${f%.tar}; done < <(find "$IMAGES" -maxdepth 1 -name '*.tar' -printf '%f\n' 2>/dev/null | sort)
    read -r _ ma _ < <(meminfo_mb)
    group_mem
    printf 'version=%s\tengines=%s\tcpus=%s\tload1=%s\tvm_used=%s\tvm_max=%s\tvm_room=%s\tboxes=%s\tdisk_pct=%s\tmem_free_mb=%s\timages=%s' \
        "$VERSION" "$eng" "$(nproc)" "$l1" "$used" "${vmax:-none}" "$room" "$(grep -c . <<<"$rows")" \
        "$(df --output=pcent "$WORK" | tail -1 | tr -dc 0-9)" "$mem" "$img"
    printf '\tmem_avail_mb=%s\tgroup_mem_used_mb=%s\tgroup_mem_max_mb=%s\tvm_why=%s\tvm_fit_mb=%s\tbox_room=%s\tbox_fit_mb=%s\tbox_reserve_mb=%s\twaiting=%s\n' "${ma:--}" "$gcur" "$gmax" "$why" "$fit_mb" "$box_room" "$box_fit_mb" "$BOX_RESERVE" "$(queue_live | grep -c .)"
}

# ---- The reading verbs for the dashboard: pod report, pod calls, pod log (docs/pod-contract.md). Read only like pod status:
# no lock, no .last-used stamp, no call log line, nothing started or stopped.

# Whole lines of a file, in one answer at most READ_MAX bytes: window <file> <offset, or empty> sets size, from and next.
# No offset: the last READ_MAX bytes from a line start; an offset past the end: from 0. A line still being written (no newline
# yet) waits for the next call; one longer than the limit is cut at the limit, so a reader always advances. win_out prints it.
window() {
    local f=$1 lim
    size=$(stat -c %s "$f" 2>/dev/null) || size=0
    from=${2:-$((size - READ_MAX))}
    [ "$from" -ge 0 ] && [ "$from" -le "$size" ] || from=0
    # The byte before $from is a newline when it starts a line; else go on to the next line start.
    [ -n "${2:-}" ] || [ "$from" -eq 0 ] || from=$((from - 1 + $(tail -c +"$from" "$f" | head -n 1 | wc -c)))
    lim=$((size - from)); [ "$lim" -le "$READ_MAX" ] || lim=$READ_MAX
    # The sentinel line makes a last line without newline the one sed leaves out: the bytes counted are the whole lines.
    WIN=$({ tail -c +$((from + 1)) "$f" 2>/dev/null | head -c "$lim"; echo x; } | sed -n '$!p' | wc -c)
    [ "$WIN" -gt 0 ] || [ "$lim" -lt "$READ_MAX" ] || WIN=$lim
    next=$((from + WIN))
}
win_out() { [ "$WIN" -eq 0 ] || tail -c +$((from + 1)) "$1" | head -c "$WIN"; }
# The offset word of pod calls and pod log: nothing, or at most 18 digits (no octal surprises: base 10).
read_offset() { [ -z "$1" ] || { [[ $1 =~ ^[0-9]{1,18}$ ]] || die "bad offset"; echo $((10#$1)); }; }

pod_calls() {
    local f=$WORK/cache/calls.log size from next WIN off
    off=$(read_offset "${1:-}") || exit 125
    window "$f" "$off"
    printf 'calls\tsize=%s\tfrom=%s\tnext=%s\n' "$size" "$from" "$next"
    win_out "$f"
}

# The code of the last line "EXIT <code>" of a run's log, a dash when there is none.
run_exit() { local l; l=$(tail -n 1 "$1" 2>/dev/null); [[ $l =~ ^EXIT\ ([0-9]+)$ ]] && echo "${BASH_REMATCH[1]}" || echo -; }

# run_alive <record>: the process group a detached run recorded still exists. A record outlives its run when the host lost
# power or the run was killed outright; such a run has ended (without an EXIT line).
# shortcut: after a reboot another process group of this account could carry the same number; then the run reads as running until that group ends.
run_alive() { local pg; [ -e "$1" ] && { read -r pg < "$1"; } 2>/dev/null && [[ $pg =~ ^[0-9]+$ ]] && kill -0 -- "-$pg" 2>/dev/null; }

pod_log() {
    local box=${1:-} id=${2:-} f st=ended ex=- size from next WIN off end= born extra= now
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    [[ $id =~ $RUN_RE ]] || die "bad run id"
    off=$(read_offset "${3:-}") || exit 125
    f=$WORK/jobs/$box/runs/$id.log
    [ -f "$f" ] && [ ! -L "$f" ] || die "no run $id in box $box"   # a box writes this folder: a link to another file is no run
    if run_alive "${f%.log}.pid"; then st=running; else ex=$(run_exit "$f"); fi
    # An ended run's wall time: the log is created empty when the run starts and last written when it ends. Words appended after `exit`, so a reader that takes the words by key is not disturbed.
    # shortcut: the creation time is the file system's birth time, absent (no `seconds`) where it reports none; when a report needs it there, the run's start would be written into its log.
    if [ "$st" = ended ] && end=$(stat -c %Y "$f" 2>/dev/null) && [[ $end =~ ^[0-9]+$ ]]; then
        extra=$'\tended='$end
        born=$(stat -c %W "$f" 2>/dev/null) || born=
        [[ $born =~ ^[1-9][0-9]*$ ]] && [ "$end" -ge "$born" ] && extra+=$'\tseconds='$((end - born))
    fi
    # A running run's age and silence, since the birth time and the last write of its log, one clock reading; a word is left out when its time is unreadable.
    if [ "$st" = running ]; then
        now=$(date +%s); born=$(stat -c %W "$f" 2>/dev/null) || born=; end=$(stat -c %Y "$f" 2>/dev/null) || end=
        [[ $born =~ ^[1-9][0-9]*$ ]] && [ "$now" -ge "$born" ] && extra+=$'\tage='$((now - born))
        [[ $end =~ ^[0-9]+$ ]] && extra+=$'\tquiet='$((now > end ? now - end : 0))
    fi
    window "$f" "$off"
    printf 'log\tsize=%s\tfrom=%s\tnext=%s\tstate=%s\texit=%s%s\n' "$size" "$from" "$next" "$st" "$ex" "$extra"
    win_out "$f"
}

# pod events <box> <run>: the event record of a detached run (docs/pod-contract.md, "The event record of a detached run"), one line.
# snap_read <file> <array>: the key=value lines of a snapshot into the associative array; fails when it has no time.
snap_read() {
    local -n a=$2; local k v
    a=()
    [ -f "$1" ] || return 1
    while IFS== read -r k v; do a[$k]=$v; done <"$1"
    [[ ${a[time]:-} =~ ^[0-9]+$ ]]
}
pod_events() {
    local box=${1:-} id=${2:-} f ev st=ended ex=- why=- eng=- s=- e=- sec=- k b i l first=- cn now oth=- sib=- os oe hs= he= full=yes jp=- jf=- msz=- mmb=-
    local -A S=() E=() X=() O=() D=() B=()
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    [[ $id =~ $RUN_RE ]] || die "bad run id"
    f=$WORK/jobs/$box/runs/$id.log
    [ -f "$f" ] && [ ! -L "$f" ] || die "no run $id in box $box"
    ev=$WORK/cache/events/$box/$id
    if run_alive "${f%.log}.pid"; then st=running; else ex=$(run_exit "$f"); fi
    snap_read "$ev.start" S && hs=1 && s=${S[time]}
    snap_read "$ev.end" E && he=1 && e=${E[time]}
    [ -n "$hs" ] && [ -n "$he" ] && sec=$((e - s))
    # The call log: the engine of this run (from its launch line, when no snapshot names it) and, once the window is known, the foreground calls in it.
    # A call is logged when it ends, so the first line tells whether the log reaches back to the window's start.
    while read -r k b; do case $k in n) O[$b]=1 ;; first) first=$b ;; eng) cn=$b ;; esac; done < <(awk -F'\t' -v me="$box" -v id="$id" -v s="$s" -v e="$e" '
        $1 !~ /^[0-9]+$/ { next }
        !f { f = 1; print "first", int($1 / 1000000) }
        $2 == me && $8 == id { print "eng", $3 }
        $2 != me && $5 != "detached" && s != "-" && e != "-" { b = $1 / 1000000; if (b <= e && b + $6 / 1000 >= s) print "n", $2 }' "$WORK/cache/calls.log" 2>/dev/null)
    eng=${S[engine]:-${E[engine]:-${cn:--}}}; [[ $eng =~ ^(vm|container)$ ]] || eng=-
    if [ "$st" = running ]; then why=running
    elif [ -z "$hs" ]; then why=no-start-record
    elif [ -z "$he" ]; then why=no-end-record
    elif [ "${S[boot]:--}" != "${E[boot]:--}" ]; then why=host-restarted
    else
        # The network words count too: a dash there must not pass as "nothing happened". A counter that went down (another card took the default route) is no reading either.
        for k in group_some_ms group_full_ms group_kills group_cap_kills net_tx_timeouts net_link_changes; do
            [[ ${S[$k]:-} =~ ^[0-9]+$ && ${E[$k]:-} =~ ^[0-9]+$ ]] && [ "${E[$k]}" -ge "${S[$k]}" ] || { why=counter-unreadable; break; }
        done
    fi
    if [ -n "$hs" ] && [ -n "$he" ]; then
        # The detached runs of the other boxes, and the other runs of this box (siblings; from the start record, else the log's birth, to the log's last write, or now while it runs).
        now=$(date +%s)
        while IFS= read -r l; do
            b=${l#"$WORK/jobs/"}; b=${b%%/*}; i=${l##*/}; i=${i%.log}
            [[ $b =~ $BOX_RE && $i =~ $RUN_RE ]] && [ "$i" != dockerd ] && { [ "$b" != "$box" ] || [ "$i" != "$id" ]; } || continue
            if run_alive "${l%.log}.pid"; then oe=$now; else oe=$(stat -c %Y "$l" 2>/dev/null) || continue; fi
            if snap_read "$WORK/cache/events/$b/$i.start" X; then os=${X[time]}; else os=$(stat -c %W "$l" 2>/dev/null); [[ $os =~ ^[1-9][0-9]*$ ]] || os=0; fi   # no birth time: from the beginning, so the box is listed rather than missed
            if [ "$os" -le "$e" ] && [ "$oe" -ge "$s" ]; then if [ "$b" = "$box" ]; then B[$i]=1; else O[$b]=1; fi; fi
        done < <(find "$WORK/jobs" -mindepth 3 -maxdepth 3 -path '*/runs/*.log' -type f 2>/dev/null)
        # A box that holds its run lock now and was stamped (a call begins with the stamp) no later than the window's end: a foreground call still going, not yet in the call log.
        while IFS= read -r b; do [[ $b =~ $BOX_RE && $b != "$box" ]] && box_busy "$b" && [ "$(stamp_of "$b")" -le "$e" ] && O[$b]=1; done < <(find "$WORK/jobs" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null)
        [ "$why" != - ] || { [[ $first =~ ^[0-9]+$ ]] && [ "$first" -le "$s" ] || why=calls-log-short; }
        [ ${#O[@]} -eq 0 ] || oth=$(printf '%s\n' "${!O[@]}" | sort | paste -sd,)
        [ ${#B[@]} -eq 0 ] || sib=$(printf '%s\n' "${!B[@]}" | sort | paste -sd,)
    fi
    # The end minus the start; a dash when either is not a number, and for every word after a restart (the counters began again).
    for k in group_full_ms group_some_ms group_kills group_cap_kills box_full_ms box_some_ms box_kills box_limit_kills net_tx_timeouts net_link_changes guest_kills; do
        D[$k]=-
        [ -n "$hs" ] && [ -n "$he" ] && [ "$why" != host-restarted ] && [[ ${S[$k]:-} =~ ^[0-9]+$ && ${E[$k]:-} =~ ^[0-9]+$ ]] && [ "${E[$k]}" -ge "${S[$k]}" ] && D[$k]=$((E[$k] - S[$k]))
    done
    # How full /job was at the end, a level and not a difference, so it stands after a restart; a dash with no end record or no reading.
    [ -n "$he" ] && [[ ${E[job_disk_pct]:-} =~ ^[0-9]+$ ]] && { jp=${E[job_disk_pct]}; [ "$jp" -ge 99 ] && jf=yes || jf=no; }
    # The machine size the run began with (the start record), a level like the disk, so it stands after a restart; a dash for an old record or a container box.
    [ -n "$hs" ] && [[ ${S[machine_size]:-} =~ ^(small|medium|large|xlarge)$ ]] && msz=${S[machine_size]}
    [ -n "$hs" ] && [[ ${S[machine_mb]:-} =~ ^[0-9]+$ ]] && mmb=${S[machine_mb]}
    [ "$why" = - ] || full=no
    printf 'events\tbox=%s\tid=%s\tengine=%s\tstate=%s\tcomplete=%s\twhy=%s\tstart=%s\tend=%s\tseconds=%s\texit=%s' "$box" "$id" "$eng" "$st" "$full" "$why" "$s" "$e" "$sec" "$ex"
    printf '\tgroup_stall_ms=%s\tgroup_stall_some_ms=%s\tkills=%s\tkills_by_cap=%s\tbox_stall_ms=%s\tbox_stall_some_ms=%s\tbox_kills=%s\tbox_limit_kills=%s\tnet_tx_timeouts=%s\tnet_link_changes=%s\tothers=%s\tsiblings=%s\tguest_kills=%s\tjob_disk_pct=%s\tdisk_full=%s\tmachine_size=%s\tmachine_mb=%s\n' \
        "${D[group_full_ms]}" "${D[group_some_ms]}" "${D[group_kills]}" "${D[group_cap_kills]}" "${D[box_full_ms]}" "${D[box_some_ms]}" "${D[box_kills]}" "${D[box_limit_kills]}" "${D[net_tx_timeouts]}" "${D[net_link_changes]}" "$oth" "$sib" "${D[guest_kills]}" "$jp" "$jf" "$msz" "$mmb"
}

# pod end <box> <run>: ends one detached run and nothing else (docs/pod-contract.md, "Ending a detached run"). Its processes carry
# BOXD_CALL=run-<id> (set where the run starts), so the box's other runs and calls are not touched; then its process group on the host.
# The wrapper dies before it writes its own ending, so the log gets the note, `EXIT 143` and the end snapshot here, unless the wrapper wrote them.
# shortcut: the engine is read from the run's start snapshot (container when a run of an older server has none), when that matters: try both engines.
pod_end() {
    local box=${1:-} id=${2:-} f pf pg="" i eg ev
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    [[ $id =~ $RUN_RE ]] || die "bad run id"
    f=$WORK/jobs/$box/runs/$id.log pf=${f%.log}.pid ev=$WORK/cache/events/$box/$id
    [ -f "$f" ] && [ ! -L "$f" ] || die "no run $id in box $box"
    run_alive "$pf" || { echo "run $id in box $box has already ended"; return 0; }
    CALL_T0=${EPOCHREALTIME//[!0-9]/} CALL_BOX=$box CALL_CMD="end $id"
    eg=$(sed -n 's/^engine=//p' "$ev.start" 2>/dev/null); [ "$eg" = vm ] || eg=container
    CALL_ENGINE=$eg
    read -r pg < "$pf" 2>/dev/null
    # The note goes in before anything is ended: a wrapper that still writes its own ending (exit 143 from a container, 255 from a machine) then follows it.
    [ -z "$(tail -c 1 "$f")" ] || echo >>"$f"
    echo "boxd: ended by box stop --run" >>"$f"
    if [ "$eg" = vm ]; then timeout 30 msb exec -w / "pod-$box" -- sh -c "$CALL_KILL" _ "run-$id"
    else timeout 30 podman exec "pod-$box" sh -c "$CALL_KILL" _ "run-$id"; fi </dev/null >/dev/null 2>&1
    if [[ $pg =~ ^[1-9][0-9]*$ ]] && kill -TERM -- "-$pg" 2>/dev/null; then
        for i in $(seq 50); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.1; done
        kill -KILL -- "-$pg" 2>/dev/null
        for i in $(seq 50); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.1; done
    fi
    if [ "$(run_exit "$f")" = - ]; then   # the wrapper wrote no ending of its own
        [ -z "$(tail -c 1 "$f")" ] || echo >>"$f"
        echo "EXIT 143" >>"$f"
    fi
    [ ! -e "$ev.start" ] || [ -e "$ev.end" ] || events_write "$ev.end" "$box" "$eg"
    rm -f "$pf"
    touch "$WORK/jobs/$box/.last-used" 2>/dev/null
    echo "ended run $id in box $box"
    logcall 0 "ended run $id"
}

# Megabytes a running box uses, a dash when unreadable. Container: memory.current of the cgroup of its init process ($1 is
# its pid); with "used" as $2 the figure of vm_mem instead (anonymous, shared and swapped, no file cache), which admission
# counts. Machine: resident memory of its machine process.
ctr_mb() {
    local c v k n anon="" shm="" swp=0
    [[ ${1:-} =~ ^[1-9][0-9]*$ ]] && c=$(sed -n 's/^0:://p' "$PROC/$1/cgroup" 2>/dev/null) && [ -n "$c" ] || { echo -; return; }
    if [ "${2:-}" = used ]; then
        { while read -r k n; do case $k in anon) anon=$n ;; shmem) shm=$n ;; esac; done <"$CGROOT$c/memory.stat"; } 2>/dev/null
        [ -r "$CGROOT$c/memory.swap.current" ] && read -r swp <"$CGROOT$c/memory.swap.current"
        [[ $anon =~ ^[0-9]+$ && $shm =~ ^[0-9]+$ && $swp =~ ^[0-9]+$ ]] && echo $(((anon + shm + swp) / 1048576)) || echo -
    else
        { v=$(<"$CGROOT$c/memory.current"); } 2>/dev/null && [[ $v =~ ^[0-9]+$ ]] && echo $((v / 1048576)) || echo -
    fi
}
vm_mb() {
    local p v
    p=$(pgrep -f "(^|/)msb machine --name pod-$1( |\$)" | head -n 1)
    v=$(awk '$1 == "VmRSS:" { print int($2 / 1024) }' "$PROC/${p:-x}/status" 2>/dev/null)
    echo "${v:--}"
}
# The --memory of BOXD_LIMITS in megabytes, a dash when it has none.
ctr_limit_mb() {
    [[ $LIMITS =~ --memory[\ =]([0-9]+)([bkmgBKMG]?)( |$) ]] || { echo -; return; }
    case ${BASH_REMATCH[2],,} in g) echo $((BASH_REMATCH[1] * 1024)) ;; m) echo "${BASH_REMATCH[1]}" ;; k) echo $((BASH_REMATCH[1] / 1024)) ;; *) echo $((BASH_REMATCH[1] / 1048576)) ;; esac
}
# The detached runs of a box as report lines: every running run and the three ended runs with the greatest ids, by id.
# runs/ also holds dockerd.log, which is not a run.
run_lines() {
    local d=$WORK/jobs/$1/runs f id st ex ended=0 out=""
    while IFS= read -r f; do
        id=${f%.log}; [[ $id =~ $RUN_RE ]] && [ "$id" != dockerd ] || continue
        if run_alive "$d/$id.pid"; then st=running ex=-
        else [ $((++ended)) -le 3 ] || continue; st=ended ex=$(run_exit "$d/$f"); fi
        out=$(printf 'run\tbox=%s\tid=%s\tstate=%s\texit=%s\tbytes=%s\tchanged=%s\n%s' "$1" "$id" "$st" "$ex" "$(stat -c %s "$d/$f")" "$(stat -c %Y "$d/$f")" "$out")
    done < <(find "$d" -maxdepth 1 -name '*.log' -type f -printf '%f\n' 2>/dev/null | sort -r)
    [ -z "$out" ] || printf '%s\n' "$out"
}

# Counters that only grow, so a later report minus an earlier one says what happened in between: milliseconds memory
# stalled some then all of the boxes, then the transmit timeouts and the link changes of the card of the default route.
# pressure_ms <cgroup folder>: "<some ms> <full ms> " (no newline) of its memory.pressure totals, dashes when unreadable.
pressure_ms() {
    awk '$1 == "some" || $1 == "full" { for (i = 2; i <= NF; i++) { split($i, a, "="); if (a[1] == "total") v[$1] = int(a[2] / 1000) } }
         END { printf "%s %s ", (v["some"] == "" ? "-" : v["some"]), (v["full"] == "" ? "-" : v["full"]) }' "$1/memory.pressure" 2>/dev/null || printf '%s ' - -
}
stall_counters() {
    local nic q t s=0 n=0 c
    pressure_ms "$CGROUP"
    nic=$(awk '$2 == "00000000" { print $1; exit }' "$ROUTE" 2>/dev/null)
    if [ -n "$nic" ]; then
        set +f   # the script runs without globbing; the queues are found by pattern
        for q in "$NETDIR/$nic"/queues/tx-*/tx_timeout; do
            t=$(cat "$q" 2>/dev/null); [[ $t =~ ^[0-9]+$ ]] && { s=$((s + t)); n=$((n + 1)); } || { n=0; break; }
        done
        set -f
        c=$(cat "$NETDIR/$nic/carrier_changes" 2>/dev/null)
    fi
    [[ ${c:-} =~ ^[0-9]+$ ]] || c="-"
    [ "$n" -gt 0 ] && printf '%s %s\n' "$s" "$c" || printf '%s %s\n' - "$c"
}

# event_count <events file> <key>: the number after <key> in a cgroup events file, a dash when the file or the key is not there.
event_count() { [ -r "$1" ] && awk -v k="$2" '$1 == k && $2 ~ /^[0-9]+$/ { print $2; f = 1 } END { if (!f) print "-" }' "$1" || echo -; }
# guest_read <box>: "<kill lines in the guest kernel's log (the engine's kernel has no oom_kill counter in /proc/vmstat, measured 2026-11-19)> <percent of /job in use>" read inside the running machine of the box, in one exec, plain sh
# (a minimal image has no awk). Dashes when the machine is not running (a plain exec would start it again), the exec fails or takes over 10 s.
# Not a call: no stamp, no call log line, no lock. The exec is the engine's own, as pod end's, with no input.
guest_read() {
    local o
    vm_alive "pod-$1" && o=$(timeout 10 msb exec -w / "pod-$1" -- sh -c 'set -f; : boxd-guest-read; if k=$(dmesg 2>/dev/null); then v=$(printf "%s\n" "$k" | grep -c "ut of memory: Killed process"); fi
set -- $(df -P /job | tail -n 1); d=${5%\%}; echo "${v:--} ${d:--}"' </dev/null 2>/dev/null) && [[ $o =~ ^([0-9]+|-)\ ([0-9]+|-)$ ]] && echo "$o" || echo "- -"
}
# events_snapshot <box> <vm|container>: what `pod events` differences, one key=value line each, a dash when unreadable (docs/pod-contract.md).
# All counters only grow, so the end minus the start is what happened in between. A machine has no group of its own: every box word is a dash.
events_snapshot() {
    local some full ntx nlc bl pid c g="" bs=- bf=- bk=- bc=- boot gk=- jd=- ms=- mm=- sz
    read -r some full ntx nlc < <(stall_counters)
    if [ "$2" != vm ]; then
        bl=$(podman container inspect --format '{{.State.Pid}} {{.Config.Labels}}' "pod-$1" </dev/null 2>/dev/null); pid=${bl%% *}
        [[ $pid =~ ^[1-9][0-9]*$ ]] && c=$(sed -n 's/^0:://p' "$PROC/$pid/cgroup" 2>/dev/null) && [ -n "$c" ] && g=$CGROOT$c
        jd=$(df --output=pcent "$WORK/jobs/$1" 2>/dev/null | tail -n 1 | tr -dc 0-9); jd=${jd:--}
        [ -z "$g" ] || { read -r bs bf < <(pressure_ms "$g"); bk=$(event_count "$g/memory.events" oom_kill); bc=$(event_count "$g/memory.events.local" oom); }
    fi
    # The size the box's machine has (the run began with it), by the idiom of the eviction line; both dashes for a container box.
    [ "$2" != vm ] || { read -r gk jd < <(guest_read "$1"); sz=$(cat "$WORK/jobs/$1/.vm-size" 2>/dev/null); case $sz in small|medium|xlarge) ;; *) sz=large ;; esac; ms=$sz; mm=$(lim_mb "$(size_lim "$sz")"); mm=${mm:--}; }
    boot=$(awk '$1 == "btime" { print $2 }' /proc/stat)
    printf 'engine=%s\ntime=%s\nboot=%s\ngroup_some_ms=%s\ngroup_full_ms=%s\nnet_tx_timeouts=%s\nnet_link_changes=%s\ngroup_kills=%s\ngroup_cap_kills=%s\n' \
        "$2" "$(date +%s)" "${boot:--}" "$some" "$full" "$ntx" "$nlc" "$(event_count "$CGROUP/memory.events" oom_kill)" "$(event_count "$CGROUP/memory.events.local" oom)"
    printf 'box_some_ms=%s\nbox_full_ms=%s\nbox_kills=%s\nbox_limit_kills=%s\nguest_kills=%s\njob_disk_pct=%s\n' "$bs" "$bf" "$bk" "$bc" "$gk" "$jd"
    printf 'machine_size=%s\nmachine_mb=%s\n' "$ms" "$mm"
}
# events_write <file> <box> <vm|container>: the snapshot under a temporary name, then renamed, so a reader never sees half of it.
events_write() { mkdir -p "${1%/*}" && events_snapshot "$2" "$3" >"$1.new" && mv -f "$1.new" "$1"; }

# The facts of the host, its boxes, their detached runs and the local images, in one answer (docs/pod-contract.md): tab
# separated words, the first says what the line is, the others are key=value. What cannot be read is a dash. The words
# `pod status` also has come from it, so the two always agree.
pod_report() {
    local st k v box image state engine bl mem user size lim j rl busy l5 l15 boot mt ma sw su gmax gcur oom dt du f
    local wd pd fa fb own="-" shared="-" mpk power=${BOXD_POWER:-off} ic="-" cnt="-" last="-" rat="-" ka=none lock=${BOXD_KEEPAWAKE_LOCK:-/run/boxd-keepawake.lock}
    local ist=${BOXD_IDLE_STATE:-/run/boxd-idle} vmrows="" runs="" rows used_mb cap_mb psome pfull ntx nlc
    local -a pr
    local -A S
    st=$(pod_status) || exit 125
    while IFS== read -r k v; do S[$k]=$v; done <<<"${st//$'\t'/$'\n'}"
    read -r _ l5 l15 _ </proc/loadavg
    boot=$(awk '$1 == "btime" { print $2 }' /proc/stat)
    read -r mt ma sw su < <(meminfo_mb)
    group_mem
    # memory.pressure: "some avg10=.. avg60=.." then "full ..." -> some10 some60 full10 full60
    read -r -a pr < <(awk '$1 == "some" || $1 == "full" { for (i = 2; i <= NF; i++) { split($i, a, "="); if (a[1] == "avg10") x = a[2]; if (a[1] == "avg60") y = a[2] } printf "%s %s ", x, y } END { print "" }' "$CGROUP/memory.pressure" 2>/dev/null)
    oom=$(awk '$1 == "oom_kill" { print $2 }' "$CGROUP/memory.events" 2>/dev/null)
    read -r psome pfull ntx nlc < <(stall_counters)
    read -r dt du < <(df --output=size,used "$WORK" 2>/dev/null | tail -n 1)
    [[ ${dt:-} =~ ^[0-9]+$ && ${du:-} =~ ^[0-9]+$ ]] && { dt=$((dt / 1024)); du=$((du / 1024)); } || { dt="-"; du="-"; }
    # Own: another device number than the folder above it (a mount, or a btrfs subvolume); folder: the plain folder of directory mode. Shared: the same block device as /;
    # the file system identity of stat -f is not used, the kernel mixes the subvolume into it, so two subvolumes of one btrfs differ.
    if [ -e "$WORK/.boxd-dir-mode" ]; then own=folder
    else wd=$(stat -c %d "$WORK" 2>/dev/null) && pd=$(stat -c %d "$WORK/.." 2>/dev/null) && { [ "$wd" = "$pd" ] && own=no || own=yes; }; fi
    fa=$(df --output=source "$WORK" 2>/dev/null | tail -n 1); fb=$(df --output=source / 2>/dev/null | tail -n 1)
    [ -z "$fa" ] || [ -z "$fb" ] || { [ "$fa" = "$fb" ] && shared=yes || shared=no; }
    [ "$power" = on ] || power=off
    if [ "$power" = on ]; then
        ic=${BOXD_IDLE_CHECKS:-20} rat=${BOXD_RESET_AT:-85}
        cnt=$(cat "$ist/count" 2>/dev/null) || cnt="-"; last=$(cat "$ist/last" 2>/dev/null) || last="-"
    fi
    if [ -e "$lock" ]; then flock -n -x "$lock" true 2>/dev/null && ka=free || ka=held; fi
    printf 'host\tversion=%s\tengines=%s\tcpus=%s\tload1=%s\tload5=%s\tload15=%s\tboot=%s\tmem_total_mb=%s\tmem_avail_mb=%s\tswap_total_mb=%s\tswap_used_mb=%s' \
        "${S[version]}" "${S[engines]}" "${S[cpus]}" "${S[load1]}" "$l5" "$l15" "${boot:--}" "${mt:--}" "${ma:--}" "${sw:--}" "${su:--}"
    printf '\tgroup_mem_max_mb=%s\tgroup_mem_used_mb=%s\tpressure_some10=%s\tpressure_some60=%s\tpressure_full10=%s\tpressure_full60=%s\toom_kills=%s\tpressure_some_ms=%s\tpressure_full_ms=%s\tnet_tx_timeouts=%s\tnet_link_changes=%s' \
        "$gmax" "$gcur" "${pr[0]:--}" "${pr[1]:--}" "${pr[2]:--}" "${pr[3]:--}" "${oom:--}" "$psome" "$pfull" "$ntx" "$nlc"
    printf '\tvm_used=%s\tvm_max=%s\tvm_room=%s\tvm_mem_mb=%s\tbox_mem_mb=%s\tdisk_pct=%s\tdisk_total_mb=%s\tdisk_used_mb=%s\tttl=%s\twork_own=%s\twork_shared=%s\tevict_at=%s\tevict_to=%s\tkeep_days=%s' \
        "${S[vm_used]}" "${S[vm_max]}" "${S[vm_room]}" "$(lim_mb "$VM_LIMITS")" "$(ctr_limit_mb)" "${S[disk_pct]}" "$dt" "$du" "$TTL" "$own" "$shared" "$EVICT_AT" "$EVICT_TO" "$KEEP_DAYS"
    printf '\tpower=%s\tidle_checks=%s\tidle_count=%s\tidle_last=%s\treset_at=%s\tkeepawake=%s\twaiting=%s\n' "$power" "$ic" "${cnt:--}" "${last:--}" "$rat" "$ka" "${S[waiting]:-0}"
    have_msb && vmrows=1
    rows=$(box_rows $vmrows) || exit 125   # a failed engine listing is no list (see pod_list)
    while IFS=$'\t' read -r box image state engine; do
        [[ $box =~ $BOX_RE ]] || continue
        j=$WORK/jobs/$box; [ "$state" = running ] || state=stopped
        user="-" size="-" mem="-" mpk="-"
        if [ "$engine" = vm ]; then
            size=$(cat "$j/.vm-size" 2>/dev/null); size=${size:-large}   # large when there is no record, as pod run reads it
            user=no; [ ! -e "$j/.vm-user" ] || user=yes
            lim=$(lim_mb "$(size_lim "$size")")
            mpk=$(mem_peak "$j") || mpk="-"
            [ "$state" != running ] || mem=$(vm_mb "$box")
        else
            lim=$(ctr_limit_mb)
            bl=$(podman container inspect --format '{{.State.Pid}} {{.Config.Labels}}' "pod-$box" 2>/dev/null)
            user=no; [[ $bl == *boxd.user:1* ]] && user=yes
            [ "$state" != running ] || mem=$(ctr_mb "${bl%% *}")
        fi
        # Busy while a run holds the box's .running lock (shared), tested without waiting, as reap does.
        busy=no; ! box_busy "$box" || busy=yes
        rl=$(run_lines "$box"); runs="$runs$rl"$'\n'
        printf 'box\tbox=%s\tengine=%s\timage=%s\tstate=%s\tlast_used=%s\tuser=%s\tsize=%s\tmem_limit_mb=%s\tmem_mb=%s\tbusy=%s\truns=%s\tmem_peak_mb=%s\n' \
            "$box" "$engine" "$image" "$state" "$(stamp_of "$box")" "$user" "$size" "${lim:--}" "$mem" "$busy" "$(grep -c "$(printf '\tstate=running\t')" <<<"$rl")" "$mpk"
    done < <(sort <<<"$rows")
    printf %s "$runs" | grep .
    while IFS= read -r f; do
        printf 'image\tname=%s\tbytes=%s\tbuilt=%s\tvm_loaded=%s\n' "${f%.tar}" "$(stat -c %s "$IMAGES/$f")" "$(stat -c %Y "$IMAGES/$f")" \
            "$(cat "$WORK/cache/loaded-vm-$(printf %s "localhost/${f%.tar}:latest" | cksum | cut -d' ' -f1)" 2>/dev/null || echo -)"
    done < <(find "$IMAGES" -maxdepth 1 -name '*.tar' -printf '%f\n' 2>/dev/null | sort)
    # What retention removed in the last day (cache/evictions.log), oldest first, 50 lines at most.
    awk -F'\t' -v t="$(($(date +%s) - 86400))" 'NF == 3 && $1 ~ /^[0-9]+$/ && $1 >= t { printf "evicted\tat=%s\tbox=%s\treason=%s\n", $1, $2, $3 }' "$WORK/cache/evictions.log" 2>/dev/null | tail -n 50
    return 0
}

# Keys that may only read (the dashboard's): $VIEW_KEYS lists "<type> <key> [comment]" lines. The build sshd (ExposeAuthInfo yes)
# gives the login's key in the file named by SSH_USER_AUTH, a line "publickey <type> <key>". Status 0: this login may only
# read. A list with entries and no way to tell which key logged in refuses everything, so an old settings file of the sshd
# fails closed and loudly, never open.
view_only() {
    local a t k seen=""
    [ -e "$VIEW_KEYS" ] || return 1
    [ -r "$VIEW_KEYS" ] || die "view keys cannot be read"
    awk '$1 !~ /^#/ && NF >= 2 { f = 1 } END { exit !f }' "$VIEW_KEYS" || return 1   # no entries: no key is limited
    while read -r a t k _; do
        [ "$a" = publickey ] || continue
        seen=1
        awk -v t="$t" -v k="$k" '$1 == t && $2 == k { f = 1 } END { exit !f }' "$VIEW_KEYS" && return 0
    done < <(cat "${SSH_USER_AUTH:-/dev/null}" 2>/dev/null)
    [ -n "$seen" ] || die "view keys are set but the login key is hidden; add ExposeAuthInfo yes to the build sshd"
    return 1
}

pod_stop() {
    [[ ${1:-} =~ $BOX_RE ]] || die "bad box name"
    if podman container inspect "pod-$1" >/dev/null 2>&1; then podman rm -f "pod-$1" >/dev/null || return 1; fi
    if have_msb && vmx inspect "pod-$1" </dev/null >/dev/null 2>&1; then vm_rm "pod-$1" || return 1; fi
}

# Detached runs record their process group in runs/<id>.pid. Each group gets SIGTERM and is given a moment to end
# (up to about 10 s) before its box is removed; stale records are dropped.
term_runs() {
    local f pg i
    while IFS= read -r f; do   # find, because globbing is off in this script
        read -r pg < "$f"
        if [[ $pg =~ ^[0-9]+$ ]] && kill -TERM -- "-$pg" 2>/dev/null; then
            for i in $(seq 100); do kill -0 -- "-$pg" 2>/dev/null || break; sleep 0.1; done
        fi
        rm -f "$f"
    done < <(find "$WORK/jobs" -mindepth 3 -maxdepth 3 -path '*/runs/*.pid' -type f 2>/dev/null)
}

# Local only: detached runs get SIGTERM, then every box on both engines goes; files stay.
pod_clear() {
    local n
    term_runs
    podman rm -af </dev/null >/dev/null || die "podman rm -af failed"
    if have_msb; then
        while IFS=$'\t' read -r n _; do vm_rm "$n"; done < <(vm_rows)
    fi
    echo cleared
}

# A box that exists keeps the image it was made from (intended). When the shared image localhost/<name> (an archive in $IMAGES) was
# rebuilt since, print the copy a new box would get now and return 0; else return 1, also when the check cannot be made.
# Container box: the id its container was created from ($4, read by the inspect pod_run does anyway) against the id of the tag,
# one inspect. Machine box: the archive stamp recorded at creation (.vm-image, copied from the store's own record) against the
# archive's stamp now, no inspect and no hashing.
image_stale_now() {
    local name cur
    case $2 in localhost/*) ;; *) return 1 ;; esac
    name=${2#localhost/}; name=${name%%:*}
    [ -r "$IMAGES/$name.tar" ] || return 1
    if [ "$1" = vm ]; then
        cur=$(stat -c %s:%Y "$IMAGES/$name.tar" 2>/dev/null) && [ -n "$cur" ] && [ -s "$3/.vm-image" ] && [ "$(cat "$3/.vm-image")" != "$cur" ] || return 1
    else
        cur=$(podman image inspect --format '{{.Id}}' "$2" </dev/null 2>/dev/null) && [ -n "$cur" ] && [ -n "$4" ] && [ "$4" != "$cur" ] || return 1
    fi
    echo "$cur"
}

pod_run() {
    local box=${1:-} image="" imgfile="" vm="" container="" queued="" user="" cuser="" kvm="" ckvm="" ulabels="" recreate="" snapshot="" run="" b64="" tty="" name J out rc
    local -a envs=()
    local size="" have="" lim="" asked="" pk pick chosen="" used_mb=0 cap_mb=0 max="" box_fit_mb box_why
    local kengine="" kuser="" kkvm="" kimage="" gmine="" gother="" k v2 newid="" changed="" rebuilt="" full engine=container cid="" sc="" pc="" vc="" cimg="" cst="" vimg="" vst="" other mine cur st create="" start="" again="" n
    shift
    CALL_T0=${EPOCHREALTIME//[!0-9]/} CALL_BOX=$box CALL_ENGINE=container
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    while [ $# -gt 0 ]; do
        case $1 in
            --image) [ $# -ge 2 ] || die "--image needs a value"; image=$2; shift 2 ;;
            --image-file) [ $# -ge 2 ] || die "--image-file needs a value"; imgfile=$2; shift 2 ;;
            --vm) vm=1; shift ;;
            --container) container=1; shift ;;
            --user) user=1; shift ;;
            --kvm) kvm=1; shift ;;
            --size) [ $# -ge 2 ] || die "--size needs a value"
                case $2 in small|medium|large|xlarge) size=$2 ;; *) die "bad size $2" ;; esac; shift 2 ;;
            --env) [ $# -ge 2 ] || die "--env needs a name"
                [[ $2 =~ $SECRET_RE ]] || die "--env $2: only names ending in _TOKEN, _KEY, _SECRET or _PASSWORD"
                envs+=("$2"); shift 2 ;;
            --recreate) recreate=1; shift ;;
            --queued) queued=1; shift ;;
            --snapshot) snapshot=1; shift ;;
            --detach) [[ ${2:-} =~ $RUN_RE ]] || die "bad run id"; run=$2; shift 2 ;;
            --) shift; [ $# -eq 1 ] || die "expected exactly one command word after --"; b64=$1; break ;;
            *) die "bad option $1" ;;
        esac
    done
    [ -n "$b64" ] || die "missing command"
    local n v
    for n in "${envs[@]}"; do
        v=BOXD_SECRET_$n
        [ -n "${!v+x}" ] || die "--env $n: the value did not arrive (the host's sshd must accept BOXD_SECRET_*)"
    done
    [ -z "$vm" ] || [ -z "$container" ] || die "--vm and --container cannot go together"
    if [ -n "$image" ]; then image=$(norm_image "$image") || die "image not allowed"; fi
    if [ -n "$imgfile" ]; then
        [ -z "$image" ] || die "--image and --image-file cannot go together"
        # Relative path inside the synced worktree: plain components only, none of them . or ..
        [[ $imgfile =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ && ${#imgfile} -le 200 && /$imgfile/ != */./* && /$imgfile/ != */../* ]] || die "bad image file path"
    fi
    [[ $b64 =~ $B64_RE ]] && printf %s "$b64" | base64 -d >/dev/null 2>&1 || die "bad command encoding"
    local -a argv
    mapfile -d '' -t argv < <(printf %s "$b64" | base64 -d)
    [ -n "${argv[0]:-}" ] || die "empty command"
    CALL_CMD="${argv[*]}"; CALL_CMD=${CALL_CMD//[[:cntrl:]]/ }; CALL_CMD=${CALL_CMD:0:200}   # the log's columns and lines stay whole
    [ -z "$vm" ] || have_msb || die "virtual machines are not installed on this host"

    name=pod-$box J=$WORK/jobs/$box
    local tl=${EPOCHREALTIME//[!0-9]/}
    # Again when the folder was removed (retention) while this call waited: the lock it then holds is of a file that is gone.
    while :; do
        mkdir -p "$J" || die "cannot create $J"
        exec 9>"$J/.lock"
        flock 9
        [ "$J/.lock" -ef /dev/fd/9 ] && break
    done
    CALL_WAIT=$(( (${EPOCHREALTIME//[!0-9]/} - tl) / 1000 ))
    mkdir -p "$J/src" "$J/runs" "$WORK/cache/pod"
    if [ -n "$MAVEN_MIRROR" ]; then
        out="<settings><mirrors><mirror><id>boxd-mirror</id><mirrorOf>central</mirrorOf><url>$MAVEN_MIRROR</url></mirror></mirrors></settings>"
        [ "$(cat "$WORK/cache/pod/maven-settings.xml" 2>/dev/null)" = "$out" ] || printf '%s\n' "$out" > "$WORK/cache/pod/maven-settings.xml"
    fi

    # Build the agent's own image from its Containerfile (the sync made it part of src). All build output goes to
    # stderr: stdout is the command's. A failed build leaves the old box alone. Dangling layers of older builds go.
    if [ -n "$imgfile" ]; then
        # realpath: a link inside the worktree must not point the build at a file outside it.
        full=$(realpath -e "$J/src/$imgfile" 2>/dev/null) && [ -f "$full" ] && [[ $full == "$(realpath "$J/src")"/* ]] || die "image file $imgfile not found"
        image=localhost/built-$box:latest
        # A shared image (localhost/<name>) the disk-pressure sweep removed is loaded again from its archive, as a plain --image call does: the build would fail on a pull.
        local fw fr
        while read -ra fw; do
            [[ ${fw[0]:-} == [Ff][Rr][Oo][Mm] ]] || continue
            for fr in "${fw[@]:1}"; do
                [[ $fr == --* ]] && continue
                [[ $fr =~ ^localhost/[a-z0-9][a-z0-9._-]*(:[A-Za-z0-9._-]+)?$ ]] && ensure_image container "$fr"
                break
            done
        done <"$full"
        # The build's output goes to a file in the cache folder (the box folder is mounted into the box), not to the caller: it is
        # noise on every call, and names the tags of other boxes that share an image id. A failed build prints it; a long one says so.
        bl=$WORK/cache/build-$box.log bt=$SECONDS   # the file is not under cache/pod: boxes see that folder as /cache
        ( trap 'kill $s 2>/dev/null; exit' TERM
          while :; do sleep "${BOXD_BUILD_NOTE:-20}" & s=$!; wait $s; echo "boxd-pod: building the box's image, $((SECONDS - bt)) s so far" >&2; done ) </dev/null 9>&- >/dev/null &
        lp=$!
        podman build -f "$full" -t "$image" "$(dirname "$full")" </dev/null 9>&- >"$bl" 2>&1 && brc=0 || brc=$?
        kill "$lp" 2>/dev/null; wait "$lp" 2>/dev/null
        bt=$((SECONDS - bt))
        [ "$brc" = 0 ] || { cat "$bl" >&2; rm -f "$bl"; die "image build failed"; }
        rm -f "$bl"
        podman image prune -f </dev/null 9>&- >/dev/null 2>&1 || true
        newid=$(podman image inspect --format '{{.Id}}' "$image" </dev/null) && [ -n "$newid" ] || die "cannot read the id of the built image"
        [ "$newid" = "$(cat "$J/.built-id" 2>/dev/null)" ] || changed=1
    fi

    # The box may exist on either engine; the engine is part of the box, like its image.
    # "<image> <state> map[<label>:<value> ...]": the labels tell whether the box was made with --user.
    if out=$(podman container inspect --format '{{.Image}} {{.Config.Image}} {{.State.Status}} {{.Config.Labels}}' "$name" 2>/dev/null); then
        cid=${out%% *} out=${out#* }
        pc=1 cimg=${out%% *} cst=${out#* } ulabels=${cst#* } cst=${cst%% *}
        [[ $ulabels == *boxd.user:1* ]] && cuser=1
        [[ $ulabels == *boxd.kvm:1* ]] && ckvm=1
    fi
    if have_msb && out=$(vm_inspect "$name"); then vc=1 vimg=${out% *} vst=${out##* }; fi
    # A box that is gone (stopped, or removed by the idle time limit) while its folder stays: the folder's record (.kind, written at
    # creation) says what kind it was. A call that names no engine makes it again as it was; a call that names the other engine is
    # refused below as if the box still stood. Every value is checked again here: the box's own processes can write in the folder.
    if [ -z "$pc$vc" ] && [ -f "$J/.kind" ]; then
        while IFS== read -r k v2; do
            case $k in
                engine) case $v2 in vm|container) kengine=$v2 ;; esac ;;
                user) [ "$v2" != 1 ] || kuser=1 ;;
                kvm) [ "$v2" != 1 ] || kkvm=1 ;;
                image) kimage=$(norm_image "$v2") || kimage= ;;
            esac
        done <"$J/.kind"
        if [ -n "$kengine" ]; then
            [ -n "$vm" ] || [ -n "$container" ] || [ "$kengine" != vm ] || vm=1
            if [ "$kengine" = vm ] && [ -n "$vm" ]; then gmine=1
            elif [ "$kengine" = container ] && [ -z "$vm" ]; then gmine=1
            else gother=1; fi
        fi
    fi
    # Sticky boxes: an existing box keeps its engine and image unless the call names them; a new box gets the
    # defaults (container, BOXD_IMAGE). Only a named engine or image that differs needs --recreate.
    if [ -z "$vm" ] && [ -z "$container" ] && [ -n "$vc" ] && [ -z "$pc" ]; then vm=1; fi
    [ -z "$vm" ] || engine=vm
    CALL_ENGINE=$engine
    # --user is sticky like the engine and the image: a box made with it keeps it, also through --recreate.
    # A machine has no label: its record is the file .vm-user in the box folder, next to .vm-size.
    if [ -n "$vm" ]; then cuser=; [ ! -e "$J/.vm-user" ] || cuser=1; fi
    [ -z "$gmine" ] || [ -n "$vm" ] || { cuser=$kuser; ckvm=$kkvm; }   # a container has its labels only while it exists
    [ -z "$cuser" ] || user=1
    # --kvm is sticky the same way, and for container boxes only (a virtual machine box has no nested virtualization:
    # no /dev/kvm, no vmx or svm flag inside, checked on the tower 2026-11-14).
    [ -z "$vm" ] || [ -z "$kvm" ] || die "--kvm is only for container boxes"
    [ -n "$vm" ] || [ -z "$ckvm" ] || kvm=1
    # The size of a virtual machine box is recorded at creation (large when there is no record: today's machine).
    [ -n "$vm" ] || [ -z "$size" ] || die "--size is only for virtual machine boxes"
    if [ -n "$vm" ]; then have=$(cat "$J/.vm-size" 2>/dev/null); have=${have:-large}; fi
    if [ -n "$vm" ]; then mine=$vc other=$pc cur=$vimg st=$vst; else mine=$pc other=$vc cur=$cimg st=$cst; fi
    # A box once built from a Containerfile comes back on that build after the reaper removed it (.built-id stays).
    local dflt=$DEFAULT_IMAGE
    [ -z "$gmine" ] || [ -z "$kimage" ] || dflt=$kimage   # an image named at creation comes back too
    [ ! -s "$J/.built-id" ] || dflt=localhost/built-$box:latest
    [ -n "$image" ] || image=${cur:-${vimg:-${cimg:-$dflt}}}
    if [ -z "$recreate" ]; then
        # Found on both engines (only after a crash) counts as found on the other one.
        if [ -n "$other$gother" ]; then
            [ -n "$vm" ] && die "box $box is a container, asked for a virtual machine; add --recreate"
            die "box $box is a virtual machine, asked for a container; add --recreate"
        fi
        [ -z "$mine" ] || [ "$cur" = "$image" ] || [ -n "$imgfile" ] || die "box $box runs $cur, asked for $image; add --recreate"
        [ -z "$mine$gmine" ] || [ -z "$user" ] || [ -n "$cuser" ] || die "box $box was made without --user, asked for --user; add --recreate"
        [ -z "$mine$gmine" ] || [ -z "$kvm" ] || [ -n "$ckvm" ] || die "box $box was made without --kvm, asked for --kvm; add --recreate"
        [ -z "$mine" ] || [ -z "$size" ] || [ "$size" = "$have" ] || die "box $box is $have, asked for $size; add --recreate"
    fi
    asked=$size
    size=${size:-$have}
    lim=$(size_lim "$size")
    # A box made from an older build of the Containerfile is replaced without --recreate (files stay).
    [ -z "$mine" ] || [ -z "$changed" ] || rebuilt=1
    # --recreate always gives a fresh box, also with the same engine and image.
    if [ -n "$mine" ] && [ -z "$recreate" ] && [ -z "$rebuilt" ]; then
        [ "$st" = running ] || start=1
    else
        create=1 start=1
    fi
    # A machine made for a box with no --size and a recorded need: the smallest size that holds it with a quarter to spare, never above the
    # default. A new machine after --recreate has no record. The size is recorded below as for any size, and admission counts it.
    if [ -n "$vm" ] && [ -n "$create" ] && [ -z "$asked" ] && [ -z "$recreate" ] && pk=$(mem_peak "$J") && pick=$(size_for_peak "$pk"); then
        size=$pick chosen=$pk lim=$(size_lim "$size")
    fi

    # Every refusal comes before any removal, so a refused call keeps the old box.
    if [ -n "$create" ] && [ -n "$kvm" ]; then
        { [ -r "$KVM" ] && [ -w "$KVM" ]; } || die "--kvm: $KVM is missing or the build account may not open it"
        # The kvm group passes the test above on the host but not inside a box: the account's own rule is what opens it there.
        ! command -v getfacl >/dev/null 2>&1 || getfacl -cp "$KVM" 2>/dev/null | grep -q "^user:$(id -un):rw" \
            || die "--kvm: $KVM has no access rule for $(id -un); run boxd-setup on this host"
    fi
    if [ -n "$create" ]; then
        if [ -n "$imgfile" ] && [ -n "$vm" ] && { [ -n "$changed" ] || ! vmx image inspect "$image" </dev/null >/dev/null 2>&1; }; then
            # The virtual machine engine has its own store: hand it the build (new, or never handed over, as when a container
        # box built from the same file becomes a vm box) through an archive that outlives a plain reset.
            # podman save refuses an existing archive ("docker-archive doesn't support modifying existing images"):
            # a fresh file, renamed over the old one.
            local ar=$WORK/cache/images/built-$box.tar
            mkdir -p "$WORK/cache/images" && rm -f "$ar.new" \
                && podman save -o "$ar.new" "$image" </dev/null 9>&- >&2 && mv -f "$ar.new" "$ar" || die "cannot save the built image"
            ensure_image vm "$image" force
        else
            ensure_image "$engine" "$image"
        fi
    fi
    # Each allowed service is a rule on top of the public profile; with no setting, microsandbox's default stays.
    local -a net=()
    if [ -n "$vm" ] && [ -n "$create" ] && [ -n "$VM_NET_ALLOW" ]; then
        net=(--net public)
        for a in $VM_NET_ALLOW; do
            [[ $a =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?:(tcp|udp):[0-9]{1,5}(-[0-9]{1,5})?$ ]] || die "bad BOXD_VM_NET_ALLOW entry: $a"
            net+=(--net-rule "allow@$a")
        done
    fi
    if [ -n "$vm" ] && [ -n "$start" ]; then
        out=$(vm_never "$size" "$(lim_mb "$lim")"); [ -z "$out" ] || die "$out"
    fi
    if [ -n "$vm" ] && [ -n "$start" ]; then
        # One admission at a time: the lock is held until the sandbox exists, so two first calls cannot both take the last room.
        exec 7>"$WORK/cache/vm-room.lock"
        flock 7
        queue_look "$box"
        out=$(vm_refusal "$name" "$(lim_mb "$lim")") hope=
        [ -z "$out" ] || hope=$(SKIP_IDLE=1 vm_refusal "$name" "$(lim_mb "$lim")")
        # No room: idle machines go, the longest unused first, until this one fits. None goes when the sizes of the busy
        # machines alone refuse it (the answer with the idle ones left out names another rule than the measured memory).
        # Before any goes, the waiting line: a call today's check would admit gives way to an earlier waiter that fits.
        if [ -z "$hope" ] || [[ $hope == *" MB in use + "* ]]; then
            queue_gate "$box" "vm $(lim_mb "$lim")" "virtual machine"
            while [ -n "$out" ] && vm_evict_idle "$name"; do out=$(vm_refusal "$name" "$(lim_mb "$lim")"); done
        fi
        [ -z "$out" ] || room_refused "$box" "vm $(lim_mb "$lim")" "no room for another virtual machine ($out); wait for one to end or stop one"
    fi
    # A container box: a call that starts work in one that is not busy is admitted by the reserve (box_fit); one already busy adds
    # nothing and is never refused here. The room lock is held until this call holds .running below, so ten calls at once are
    # counted one after the other, each seeing the busy boxes of those before it.
    if [ -z "$vm" ] && [ "$BOX_RESERVE" -gt 0 ] && ! box_busy "$box"; then
        exec 7>"$WORK/cache/vm-room.lock"
        flock 7
        queue_look "$box"
        kept=$([ -n "$create$start" ] || echo kept)   # a box that runs and is kept counts what it uses when that is more than the reserve
        box_fit "$box" "$kept"
        # No room: idle machines go, the longest unused first, until the call fits, and none when all of them together would not make it fit.
        # Before any goes, the waiting line: a call today's check would admit gives way to an earlier waiter that fits.
        if [ -z "$box_why" ] || { have_msb && (SKIP_IDLE=1; box_fit "$box" "$kept"; [ -z "$box_why" ]); }; then
            queue_gate "$box" box "busy box"
            while [ -n "$box_why" ] && vm_evict_idle "$name"; do box_fit "$box" "$kept"; done
        fi
        [ -z "$box_why" ] || room_refused "$box" box "no room for another busy box ($box_why); wait for one to end$(have_msb && vm_calm && echo ', or stop a machine that has no run (box stop)')"
    fi
    rm -f "$QUEUE/$box" 2>/dev/null   # admitted (or never refused): the call's ticket, if any, is spent
    if [ -n "$recreate" ] || [ -n "$rebuilt" ]; then
        [ -z "$pc" ] || podman rm -f "$name" >/dev/null
        [ -z "$vc" ] || vm_rm "$name"
        [ -z "$recreate" ] || rm -f "$J/.mem-peak"   # a fresh machine starts the measure from nothing (a rebuilt one keeps it)
    fi
    # 9>&- 7>&- : the long-lived box processes must not inherit the locks.
    if [ -n "$vm" ]; then
        if [ -n "$create" ]; then
            # --user: both mounts present their files as the account (uid and gid VM_UID), see GUEST_USER; no --user: the line as it was.
            local mo=""; [ -z "$user" ] || mo=",uid=$VM_UID,gid=$VM_UID"
            vmx create --name "$name" \
                --mount-dir "$J:/job:host-perms=mirror$mo,quota=$VM_JOB_DISK" --mount-dir "$WORK/cache/pod:/cache:host-perms=mirror$mo,quota=$VM_CACHE_DISK" \
                --mount-owned /var/lib/docker:kind=disk,size=$VM_ENGINE_DISK --mount-owned /var/lib/containers:kind=disk,size=$VM_ENGINE_DISK \
                --mount-owned /tmp:kind=disk,size=$VM_TMP_DISK \
                "${CACHE_ENV[@]}" \
                "${net[@]}" $lim "$image" </dev/null 9>&- 7>&- >/dev/null || die "cannot create box $box"
        elif [ -n "$start" ]; then
            vmx start "$name" </dev/null 9>&- 7>&- >/dev/null || die "cannot start box $box"
        fi
        exec 7>&-
        vmx exec -w / "$name" -- sh -c "${start:+$GUEST_PID_MAX; }$GUEST_MEM_START"$'\n'"$DOCKER_START" </dev/null 9>&- >/dev/null 2>&1 || true
    elif [ -n "$create" ]; then
        local -a uflags=()
        if [ -n "$user" ]; then
            # keep-id: the build account's uid inside equals its uid on the host, so files under /job stay its own.
            mkdir -p "$J/home" || die "cannot create $J/home"
            uflags=(--userns=keep-id --label boxd.user=1 -e HOME=/job/home)
        fi
        # --kvm: QEMU inside runs on KVM. The build account opens it through its own access rule on the device (boxd-setup):
        # rootless runc drops the kvm group inside, the user id stays.
        [ -z "$kvm" ] || uflags+=(--device "$KVM" --label boxd.kvm=1)
        # --oom-score-adj 1000: the kernel's badness is a process's memory plus score/1000 of the cgroup's limit, so 1000 adds the
        # whole cap and when the build cgroup is full the grower in a container dies before any machine (BOXD_LIMITS may override).
        # shortcut: boxes made before 0.4.9 keep their old score until recreated (--recreate, or retention removing them), when that
        # matters: write 1000 to the init process's /proc/<pid>/oom_score_adj on each call (children inherit it).
        podman run -d --init --name "$name" --hostname "$box" --label "boxd.box=$box" "${uflags[@]}" \
            -v "$J:/job" -v "$WORK/cache/pod:/cache" -w /job/src --pull=missing \
            "${CACHE_ENV[@]}" \
            --oom-score-adj 1000 $LIMITS "$image" sleep infinity 9>&- 7>&- >/dev/null || die "cannot create box $box"
    elif [ -n "$start" ]; then
        podman start "$name" 9>&- 7>&- >/dev/null || die "cannot start box $box"
    fi
    # First call into a new folder whose box name was evicted before: say so once, the caller's ignored files are gone.
    if [ ! -e "$J/.last-used" ] && out=$(awk -F'\t' -v b="$box" '$2 == b {l = $0} END {print l}' "$WORK/cache/evictions.log" 2>/dev/null) && [ -n "$out" ]; then
        echo "boxd-pod: the folder of this box was removed on $(date -d "@${out%%$'\t'*}" +%F) (${out##*$'\t'}); it starts empty" >&2
    fi
    [ -z "$create" ] || [ ! -e "$J/.last-used" ] || again=1   # the folder was used by an earlier box: this one is made again over it (read before the stamp is touched)
    touch "$J/.last-used"   # inside the lock, so reap never sees a box without a stamp
    # Which build the box was made from; a box made from another image has no record, so the next build replaces it.
    if [ -n "$create" ]; then
        if [ -n "$vm" ]; then printf %s "$size" >"$J/.vm-size"; else rm -f "$J/.vm-size"; fi
        if [ -n "$vm" ] && [ -n "$user" ]; then : >"$J/.vm-user"; else rm -f "$J/.vm-user"; fi
        # The quotas the machine was made with (a machine made before 0.4.46 has none: 4G, told once below).
        if [ -n "$vm" ]; then echo "$VM_JOB_DISK $VM_CACHE_DISK" >"$J/.vm-quota"; else rm -f "$J/.vm-quota"; fi
        # The copy of the shared image the box is made from (a machine: the archive stamp its store was loaded from; a container's
        # id is read from podman later) and the told-once marker start over.
        rm -f "$J/.image-told" "$J/.vm-image"
        [ -z "$vm" ] || cp "$WORK/cache/loaded-vm-$(printf %s "$image" | cksum | cut -d' ' -f1)" "$J/.vm-image" 2>/dev/null || true
        if [ -n "$imgfile" ]; then printf %s "$newid" >"$J/.built-id"
        elif [ "$image" != "localhost/built-$box:latest" ]; then rm -f "$J/.built-id"; fi
    fi
    # What the folder remembers of the box's kind (read above when the box is gone): written at creation, and once for a box
    # made by an older server that has no record yet. The image only when it is not the default or the folder's own build.
    if [ -n "$create" ] || [ ! -e "$J/.kind" ]; then
        {
            echo "engine=$engine"; [ -z "$user" ] || echo user=1; [ -z "$kvm" ] || echo kvm=1
            [ "$image" = "$DEFAULT_IMAGE" ] || [ "$image" = "localhost/built-$box:latest" ] || echo "image=$image"
        } >"$J/.kind.new" && mv -f "$J/.kind.new" "$J/.kind"
    fi
    # A box this call did not make that runs an older copy of its shared image: said once per copy, one line.
    if [ -z "$create" ] && [ -n "$mine" ] && [ -z "$imgfile" ] && sc=$(image_stale_now "$engine" "$image" "$J" "$cid") && [ "$sc" != "$(cat "$J/.image-told" 2>/dev/null)" ]; then
        echo "boxd-pod: box $box runs an older copy of ${image%%:*} (the image was rebuilt since the box was made); --recreate gives it the new one" >&2
        printf %s "$sc" >"$J/.image-told"
    fi
    # A machine made by an older server has a 4G quota on /job and /cache that only --recreate changes: said once, then recorded.
    if [ -z "$create" ] && [ -n "$vm" ] && [ -n "$mine" ] && [ ! -e "$J/.vm-quota" ]; then
        echo "boxd-pod: machine box $box was made with a 4 GiB limit on /job and /cache (an older server); --recreate gives it $VM_JOB_DISK and $VM_CACHE_DISK (files stay)" >&2
        echo "4G 4G" >"$J/.vm-quota"
    fi
    exec 9>&-

    if [ -n "$snapshot" ]; then
        (
            cd "$J/src" || exit 1
            [ -e .git ] || git init -q
            git add -A
            git -c user.name=boxd -c user.email=boxd@localhost -c commit.gpgsign=false commit -q --allow-empty -m snapshot
        ) </dev/null >/dev/null || die "snapshot failed"
    fi

    # --user in a machine: the account (see GUEST_USER); the command runs as it, with the home the container side has.
    local -a vu=()
    if [ -n "$vm" ] && [ -n "$user" ]; then
        local un
        mkdir -p "$J/home" || die "cannot create $J/home"   # on the host: the mounts present it as the account's (made by the guest's root it would be root's)
        un=$(vmx exec -w / "$name" -- sh -c "$GUEST_USER" _ "$VM_UID" </dev/null 2>/dev/null); rc=$?
        [ $rc -ne 3 ] || die "--user needs useradd in the machine's image"
        un=${un##*$'\n'}
        [ $rc -eq 0 ] && [[ $un =~ ^[A-Za-z0-9_.-]+$ ]] || die "cannot set up the account of box $box"
        vu=(-u "$un" -e HOME=/job/home)
    fi
    # Said once, when the box is made, after the refusals and the snapshot so that a refused call has one line: root in a box is not obvious, and a test failure caused by it was taken for a real one.
    if [ -n "$create" ]; then
        if [ -n "$vm" ]; then
            if [ -n "$user" ]; then echo "boxd-pod: new machine box $box: commands run as an ordinary account (--user)" >&2
            else echo "boxd-pod: new machine box $box: commands run as root; an ordinary account needs --user at creation" >&2; fi
            # What the machine really got: "large" is the host's own default and differs between hosts (a run sized for 8 GB got 4 GB unnoticed).
            [[ $lim =~ -c\ ([0-9]+) ]] && echo "boxd-pod: machine box $box: size $size on this host is $(lim_mb "$lim") MB of memory and ${BASH_REMATCH[1]} processors (--size small, medium, large or xlarge at creation)" >&2
            [ -z "$chosen" ] || echo "boxd-pod: machine box $box: size $size chosen from its past need of $chosen MB (give --size to choose yourself)" >&2
        elif [ -n "$user" ]; then echo "boxd-pod: new container box $box: commands run as an ordinary account (--user)" >&2
        else echo "boxd-pod: new container box $box: commands run as root; an ordinary account needs --user at creation" >&2; fi
        # A box made again over a kept folder (after pod stop, the idle time limit, an eviction or --recreate): /job and /cache stay, the rest of
        # its file system is new. With --user the home is /job/home, so it stays.
        if [ -n "$again" ]; then
            local rest="the home folder outside /job, packages installed with the system's package tool"; [ -z "$user" ] || rest="packages installed with the system's package tool"
            echo "boxd-pod: $([ -n "$vm" ] && echo machine || echo container) box $box: made again from its image: /job and /cache were kept; everything else is new ($rest; build those into the image with --image-file to keep them)" >&2
        fi
    fi

    # Said for every call that runs a command (2026-11-20: three whole build suites ran at once on a 16 processor host, load 20, a 155 second test
    # took 35 minutes and nothing told the caller). Admission stays by memory only; this only tells. Whole numbers: the integer part of the 1 minute load
    # against the processor count. shortcut: the other boxes are counted by box_busy (a run or call), not by what they use; upgrade when that misleads.
    local busy_l1 busy_k=0 busy_b busy_st busy_who
    read -r busy_l1 _ 2>/dev/null <"$PROC/loadavg" || busy_l1=0   # 2>/dev/null first: the shell reports a missing file before a later redirection applies
    if [[ $busy_l1 =~ ^([0-9]+) ]] && [ "${BASH_REMATCH[1]}" -gt "$(nproc)" ]; then
        while IFS=$'\t' read -r busy_b _ busy_st _; do
            [ "$busy_st" = running ] && [ "$busy_b" != "$box" ] && box_busy "$busy_b" && busy_k=$((busy_k + 1))
        done <<<"$(box_rows $(have_msb && echo 1) 2>/dev/null)"
        case $busy_k in 0) busy_who="no other box runs a command" ;; 1) busy_who="1 other box runs a command" ;; *) busy_who="$busy_k other boxes run commands" ;; esac
        echo "boxd-pod: this host is busy: load $busy_l1 on $(nproc) processors, $busy_who; this command will be slow (wait, or use another build server)" >&2
    fi

    local -a eng
    [ -z "${SSH_TTY:-}" ] || tty=-t
    # --env values: into this process's environment only now (the engines take a bare -e NAME from it), carriers cleared.
    local -a ev=()
    for n in "${envs[@]}"; do v=BOXD_SECRET_$n; export "$n=${!v}"; ev+=(-e "$n"); done
    for v in ${!BOXD_SECRET_*}; do unset "$v"; done
    local -a eu=()
    [ -z "$user" ] || eu=(--user "$(id -u):$(id -g)" -e HOME=/job/home)
    # A detached run carries a marker as a foreground call does, so pod end finds its processes.
    local -a mk=(); [ -z "$run" ] || mk=(-e "BOXD_CALL=run-$run")
    if [ -n "$vm" ]; then eng=(msb exec --stream "${vu[@]}" "${ev[@]}" "${mk[@]}" -w /job/src "$name" --); else eng=(podman exec "${eu[@]}" "${ev[@]}" "${mk[@]}" -w /job/src "$name"); fi

    # Said here, not at the build: a refusal further on stays the only boxd-pod line of its call.
    [ -z "$changed" ] || [ -z "$imgfile" ] || echo "boxd-pod: built the box's image from $imgfile ($bt s)" >&2
    if [ -n "$run" ]; then
        # Two runs of a box share /job/src: the caller is told, the run starts as before.
        local rp live=()
        while IFS= read -r rp; do run_alive "$J/runs/$rp.pid" && live+=("$rp"); done < <(find "$J/runs" -maxdepth 1 -name "*.pid" -type f -printf "%f\n" 2>/dev/null | sed "s/\.pid$//" | sort)
        [ ${#live[@]} = 0 ] || echo "boxd-pod: run ${live[0]} is still going in this box${live[1]:+ (and $((${#live[@]} - 1)) more)}; both use the same /job/src" >&2
        : > "$J/runs/$run.log"
        # The shared lock is taken here and the wrapper inherits it (it also takes its own below): the box is busy from now on, so the
        # next admission, which gets the room lock back at once, counts it.
        exec 8>>"$J/.running"; flock -s 8; exec 7>&-
        [ -z "$vm" ] || eng+=(sh -c "$GUEST_KILLS" _)   # detached runs only: a foreground call has no log to hold the lines
        # The wrapper's own words are fixed (with this script's functions for the note of a machine that ended); the client's
        # words travel as arguments only. The shared lock on .running tells reap this box is busy.
        # The event record (pod events) goes to $WORK/cache/events, which no mount of the box shows: the box folder is mounted whole.
        CGROOT=$CGROOT PROC=$PROC ROUTE=$ROUTE NETDIR=$NETDIR WORK=$WORK VM_LIMITS=$VM_LIMITS setsid bash -c "$(declare -f vm_alive oom_kills vm_end_note ctr_end_note stall_counters pressure_ms event_count guest_read lim_mb size_lim events_snapshot events_write)"'
            j=$1; log=$2; CGROUP=$3; sb=$4; bx=$5; ev=$6; shift 6
            echo $$ > "${log%.log}.pid"
            k0=$(oom_kills)
            eg=container; [ -z "$sb" ] || eg=vm
            rm -f "$ev.end"; events_write "$ev.start" "$bx" "$eg"
            boxd-keepawake flock -s "$j/.running" "$@" >"$log" 2>&1
            rc=$?
            events_write "$ev.end" "$bx" "$eg"
            if [ -n "$sb" ]; then vm_end_note "$sb" "$bx" "$k0"; else ctr_end_note "$bx" "$k0" "$rc"; fi >>"$log"
            touch "$j/.last-used"
            rm -f "${log%.log}.pid"
            echo "EXIT $rc" >>"$log"' _ "$J" "$J/runs/$run.log" "$CGROUP" "${vm:+$name}" "$box" "$WORK/cache/events/$box/$run" "${eng[@]}" "${argv[@]}" \
            </dev/null >/dev/null 2>&1 &
        echo "$run"
        CALL_RUN=$run
        logcall detached
        exit 0
    fi

    # Held for the whole foreground run so reap spares a run that outlasts the time limit.
    exec 8>>"$J/.running"
    flock -s 8
    exec 7>&-   # the room lock of a container call (above): busy now, so the next admission counts this box
    # And the host stays awake for it: the call's own ssh connection does not count for the sleep module when it comes from an
    # address of BOXD_IDLE_IGNORE (a runner beside the dashboard), and a command that waits makes no load.
    if [ -r "${BOXD_KEEPAWAKE_LOCK:-/run/boxd-keepawake.lock}" ]; then exec 6<"${BOXD_KEEPAWAKE_LOCK:-/run/boxd-keepawake.lock}"; flock -s 6; fi
    local k0; k0=$(oom_kills)
    if [ -n "$tty" ]; then   # on a terminal sshd hangs the session up and the engine follows it
        if [ -n "$vm" ]; then
            vmx exec $tty "${vu[@]}" "${ev[@]}" -w /job/src "$name" -- "${argv[@]}"
        else
            podman exec -i $tty "${eu[@]}" "${ev[@]}" -w /job/src "$name" "${argv[@]}"
        fi
        rc=$?
    else
        # No terminal: a foreground command lives as long as the session that started it (sshd's session process is this
        # script's parent). sshd does not hang a session without a terminal up, so a killed client used to leave the command
        # running with the box's .running lock held. Now the engine runs in the background, a watcher notices the parent
        # change and hangs this script up, and a hangup, termination or broken pipe here ends the call: the cleanup script
        # ends every process carrying the call's marker inside the box, then the host-side engine process goes.
        # shortcut: a command that clears its environment (env -i) is not found, and the parent is the nearest process only
        # (a wrapper shell between sshd and this script that stays alive hides the session's end); the box's time limit
        # still takes the box once the call's lock is gone.
        local call=c$$-${EPOCHREALTIME//[!0-9]/}-$RANDOM ep wp gone="" pp=$PPID
        trap 'gone=1' HUP TERM PIPE INT
        if [ -n "$vm" ]; then
            msb exec --stream "${vu[@]}" "${ev[@]}" -e "BOXD_CALL=$call" -w /job/src "$name" -- "${argv[@]}" <&0 &   # msb itself, not vmx: $! must be the engine process
        else
            podman exec -i "${eu[@]}" "${ev[@]}" -e "BOXD_CALL=$call" -w /job/src "$name" "${argv[@]}" <&0 &
        fi
        ep=$!
        # The watcher holds no lock and no stream (an orphaned sleep must not keep the caller's pipes open).
        (
            me=$$
            while sleep "${BOXD_WATCH_INTERVAL:-1}"; do
                read -r _ _ _ cur _ <"/proc/$me/stat" 2>/dev/null && [ "$cur" = "$pp" ] || break
            done
            kill -HUP "$me" 2>/dev/null
        ) 8>&- 6<&- </dev/null >/dev/null 2>&1 &
        wp=$!
        wait "$ep"; rc=$?   # a trapped signal ends the wait early with a status above 128 and sets gone
        kill "$wp" 2>/dev/null
        if [ -n "$gone" ]; then
            trap '' HUP TERM PIPE INT
            if [ -n "$vm" ]; then
                timeout 30 msb exec -w / "$name" -- sh -c "$CALL_KILL" _ "$call"
            else
                timeout 30 podman exec "${eu[@]}" "$name" sh -c "$CALL_KILL" _ "$call"
            fi </dev/null 8>&- 6<&- >/dev/null 2>&1
            kill -TERM "$ep" 2>/dev/null   # a host-side engine that does not end within about 5 s is killed: it holds the box's lock
            for n in $(seq 50); do kill -0 "$ep" 2>/dev/null || break; sleep 0.1; done
            kill -KILL "$ep" 2>/dev/null; wait "$ep" 2>/dev/null
            touch "$J/.last-used"
            echo "boxd-pod: the session that started the call is gone; the call was ended" >&2
            logcall 129 "session gone"
            exit 129
        fi
    fi
    if [ -n "$vm" ]; then vm_end_note "$name" "$box" "$k0"; else ctr_end_note "$box" "$k0" "$rc"; fi >&2
    touch "$J/.last-used"
    logcall "$rc"
    exit "$rc"
}

# pod forward <box> <port>: relays this session's standard input and output to 127.0.0.1:<port> inside a running container
# box (the client's `box forward` runs one per connection). The host's socat enters the box's network namespace (nsenter
# in the build account's user namespace, which owns it), so any image works. Never creates or starts a box. Held like a
# foreground call: shared lock on .running and boxd-keepawake, so the reaper and the sleep module leave a viewer alone.
# shortcut: container boxes only (a vm box has no host-side namespace to enter), when a vm box needs a viewer: relay through msb exec.
pod_forward() {
    local box=${1:-} port=${2:-} name J st pid ep gone="" rc
    CALL_T0=${EPOCHREALTIME//[!0-9]/} CALL_BOX=$box CALL_ENGINE=container CALL_CMD="forward ${port:0:6}"
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && [ "$port" -le 65535 ] || die "bad port"
    name=pod-$box J=$WORK/jobs/$box
    if st=$(podman container inspect --format '{{.Config.Image}} {{.State.Status}} {{.Config.Labels}}' "$name" 2>/dev/null); then
        st=${st#* }; st=${st%% *}
        [ "$st" = running ] || die "box $box is not running"
    elif have_msb && vm_inspect "$name" >/dev/null; then
        die "forward is for container boxes"
    else
        die "no box $box"
    fi
    [ -d "$J" ] || die "no box $box"
    pid=$(podman container inspect --format '{{.State.Pid}}' "$name" 2>/dev/null </dev/null); pid=${pid%% *}
    [[ $pid =~ ^[1-9][0-9]*$ ]] || die "cannot read the process of box $box"
    exec 8>>"$J/.running"
    flock -s 8
    touch "$J/.last-used"
    trap 'gone=1' HUP TERM PIPE INT
    boxd-keepawake podman unshare nsenter "--net=/proc/$pid/ns/net" socat - "TCP:127.0.0.1:$port" <&0 &
    ep=$!
    wait "$ep"; rc=$?
    if [ -n "$gone" ]; then
        trap '' HUP TERM PIPE INT
        pkill -TERM -P "$ep" 2>/dev/null   # podman unshare leaves its child running when it is the one that is killed
        kill -TERM "$ep" 2>/dev/null; wait "$ep" 2>/dev/null
        rc=129
    fi
    touch "$J/.last-used"
    logcall "$rc"
    exit "$rc"
}

# One line per command the dispatcher below accepts over ssh. Read only: no lock, no stamp, no call log line.
# pod queue <box> box | vm <size>: a waiting call asks for its place without starting anything (the client sends it while no room shows in
# `pod status`, which cannot write). Exit 0: the room is there now, ask with pod run. Exit 75: no room, with the ticket written or
# refreshed and the place and the busy boxes in the line. Exit 125, no ticket, when the size alone never fits the host (vm_never).
# shortcut: a machine is counted at the size word asked (large when none), not at the smaller size `pod run` may pick from the
# measured need; upgrade when that difference makes a ticket wrong.
pod_queue() {
    local box=${1:-} what=${2:-} size=${3:-} queued=1 need out
    [[ $box =~ $BOX_RE ]] || die "bad box name"
    case "$what $size" in
        "box ") need=box ;;
        "vm small"|"vm medium"|"vm large"|"vm xlarge") have_msb || die "virtual machines are not installed on this host"; need="vm $(lim_mb "$(size_lim "$size")")"; out=$(vm_never "$size" "${need#vm }"); [ -z "$out" ] || die "$out" 2>&1 ;;   # standard output: the client reads that
        *) die "unknown command" ;;
    esac
    mkdir -p "$WORK/cache" || die "cannot create $WORK/cache"
    exec 7>"$WORK/cache/vm-room.lock"
    flock 7
    queue_look "$box"
    queue_fits "$box" "$need" && exit 0
    room_refused "$box" "$need" "no room for another $([ "$what" = vm ] && echo virtual machine || echo busy box) now" 2>&1   # standard output: the client reads that
}

pod_help() {
    cat <<'HELP'
pod run <box> ...      run a command in a box (starts it when missing)
pod stop <box>         stop a box, keep its folder
pod drop <box>         remove a box and its folder
pod list               boxes, one per line
pod ps <box>           processes of a running box
pod status             one line of host facts
pod report             host, boxes, runs and images in one answer
pod calls [offset]     the call log
pod log <box> <run> [offset]         output of a detached run
pod events <box> <run>               what could have disturbed a detached run
pod end <box> <run>                  end one detached run, nothing else
pod forward <box> <port>             connect to a port inside a box
pod image ...          manage local images
pod queue <box> box|vm <size>        ask for a place in the waiting line, start nothing
pod help               this list
HELP
}

if [ -n "${SSH_ORIGINAL_COMMAND:-}" ]; then
    cmd=$SSH_ORIGINAL_COMMAND
    view_only && ro=1 || ro=
    [[ $cmd =~ $LINE_RE ]] || die "unknown command"
    read -ra W <<<"$cmd"
    if [ -n "$ro" ]; then   # a key that may only read: the reading verbs, nothing else (not even the rsync passthrough)
        case "${W[0]} ${W[1]:-}" in "pod status"|"pod list"|"pod ps"|"pod report"|"pod calls"|"pod log"|"pod events"|"pod help") ;; *) die "this key may only read" ;; esac
    fi
    if [ "${W[0]}" = rsync ] && [ "${W[1]:-}" = --server ]; then
        # Relative paths in the sync land under the work area, so the client never needs to know where it is.
        cd "$WORK" || die "work area missing"
        # Only the client's own sync and pull may pass: rsync's short-option bundle, the long options the client
        # sends, "." and paths inside a box's src folder (relative, as the client writes them). Anything else could
        # write wherever the build account can (an option like --log-file=, or a destination outside a box); the
        # filter rules travel in rsync's protocol. This check comes before the mkdir below.
        for w in "${W[@]:1}"; do
            case $w in
                --server|--sender|--delete|--delete-excluded|--mkpath|--safe-links|.) continue ;;
            esac
            [[ $w =~ ^-[A-Za-z0-9.]+$ ]] && continue
            [[ $w =~ ^jobs/([^/]+)/src(/.*)?$ && ${BASH_REMATCH[1]} =~ $BOX_RE && /$w/ != */../* ]] && continue
            die "rsync refused: $w"
        done
        # Two first calls of one worktree sync at once: both rsync receivers would make the missing folder and one
        # fails with "File exists" (exit 11). Making it here, race free, leaves rsync a folder that is already there.
        if [[ ${W[*]} != *" --sender"* ]] && [[ ${W[-1]} =~ ^jobs/[A-Za-z0-9_.-]+/src/$ ]]; then
            mkdir -p "${W[-1]}" || die "cannot create ${W[-1]}"
        fi
        # A sync or a pull is a use of the box folder: it renews an existing stamp and holds the folder busy (.running, as a
        # run does), so retention never removes a folder under a transfer.
        if [[ ${W[-1]} =~ ^jobs/([^/]+)/src ]] && [ -d "jobs/${BASH_REMATCH[1]}" ]; then
            b=jobs/${BASH_REMATCH[1]}
            [ ! -e "$b/.last-used" ] || touch "$b/.last-used"
            exec flock -s "$b/.running" rsync "${W[@]:1}"
        fi
        exec rsync "${W[@]:1}"
    fi
    [ "${W[0]}" = pod ] || die "unknown command"
    case ${W[1]:-} in
        run) pod_run "${W[@]:2}" ;;
        stop) [ ${#W[@]} -eq 3 ] || die "unknown command"; pod_stop "${W[2]}" ;;
        drop) [ ${#W[@]} -ge 3 ] && [ ${#W[@]} -le 4 ] || die "unknown command"; pod_drop "${W[2]}" "${W[3]:-}" ;;
        list) [ ${#W[@]} -eq 2 ] || die "unknown command"; pod_list ;;
        ps) [ ${#W[@]} -eq 3 ] || die "unknown command"; pod_ps "${W[2]}" ;;
        status) [ ${#W[@]} -eq 2 ] || die "unknown command"; pod_status ;;
        report) [ ${#W[@]} -eq 2 ] || die "unknown command"; pod_report ;;
        calls) [ ${#W[@]} -le 3 ] || die "unknown command"; pod_calls "${W[2]:-}" ;;
        log) [ ${#W[@]} -ge 4 ] && [ ${#W[@]} -le 5 ] || die "unknown command"; pod_log "${W[@]:2}" ;;
        events) [ ${#W[@]} -eq 4 ] || die "unknown command"; pod_events "${W[@]:2}" ;;
        end) [ ${#W[@]} -eq 4 ] || die "unknown command"; pod_end "${W[@]:2}" ;;
        forward) [ ${#W[@]} -eq 4 ] || die "unknown command"; pod_forward "${W[2]}" "${W[3]}" ;;
        image) pod_image "${W[@]:2}" ;;
        queue) [ ${#W[@]} -ge 4 ] && [ ${#W[@]} -le 5 ] || die "unknown command"; pod_queue "${W[@]:2}" ;;
        help) [ ${#W[@]} -eq 2 ] || die "unknown command"; pod_help ;;
        *) die "unknown command" ;;
    esac
elif [ "${1:-}" = reap ] || [ "${1:-}" = clear ]; then
    # Called by the boxd service and boxd-reset through runuser, which keeps root's environment.
    HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
    cd "$HOME" || cd /   # podman refuses to run from a folder this account cannot enter
    [ -r /etc/profile.d/boxd-env.sh ] && . /etc/profile.d/boxd-env.sh
    if [ "$1" = clear ]; then pod_clear; else shift; reap "$@"; fi
else
    die "unknown command"
fi
