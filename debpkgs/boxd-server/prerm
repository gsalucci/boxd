#!/bin/sh
set -e
case "$1" in
remove|deconfigure)
    # Stopping boxd also removes every box (files stay); an upgrade leaves the service running.
    if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop boxd.service || true
    fi ;;
esac
exit 0
