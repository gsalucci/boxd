#!/bin/sh
# Build the boxd Debian packages with dpkg-deb. Needs dpkg-deb, tar, gzip, awk, sed, find and sha256sum (a Debian
# system or container; curl too when microsandbox-bin is built). No root: dpkg-deb --root-owner-group records
# root ownership without being root. Builds only: it never signs and never uploads (tools/publish-deb uploads).
# The file list is the Debian table of docs/designs/layout.md; the control files and maintainer scripts are debpkgs/<package>/.
#
#   tools/build-deb [package ...]      default: boxd boxd-server boxd-client microsandbox-bin
#
# Environment (all optional):
#   BOXD_DEB_OUT          where the .deb files go, default <checkout>/deb-out
#   BOXD_DEB_REVISION     Debian revision, default 1 (version is <upstream>-<revision>)
#   BOXD_SOURCE_ARCHIVE   tar.gz of a tag (top folder boxd-<version>/, from `git archive --prefix=boxd-<version>/`) to
#                         build from instead of this checkout; the version comes from the archive's own template
#   BOXD_MSB_TARBALL, BOXD_MSB_LICENSE   local copies of the pinned microsandbox files (else downloaded); the
#                         checksums of srcpkgs/microsandbox-bin/template are checked either way
#   SOURCE_DATE_EPOCH     time stamped into the files, default the last commit time, else now
set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
umask 022

if [ -n "${BOXD_SOURCE_ARCHIVE:-}" ]; then
	mkdir "$work/src"
	tar -xzf "$BOXD_SOURCE_ARCHIVE" -C "$work/src" --strip-components=1
	src=$work/src
else
	src=$repo
fi
out=${BOXD_DEB_OUT:-$repo/deb-out}
mkdir -p "$out"
rev=${BOXD_DEB_REVISION:-1}
ver=$(sed -n 's/^version=//p' "$src/srcpkgs/boxd/template")
tpl=$src/srcpkgs/microsandbox-bin/template
msbver=$(sed -n 's/^version=//p' "$tpl")
[ -n "$ver" ] && [ -n "$msbver" ] || { echo "build-deb: cannot read the versions from the templates" >&2; exit 1; }
SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(git -C "$src" log -1 --format=%ct 2>/dev/null || date +%s)}
export SOURCE_DATE_EPOCH
stamp=$(date -u -R -d "@$SOURCE_DATE_EPOCH")
packages=${*:-boxd boxd-server boxd-client microsandbox-bin}

command -v dpkg-deb >/dev/null || { echo "build-deb: dpkg-deb is missing; run this in Debian, e.g. box --image docker.io/library/debian:trixie-slim -- tools/build-deb" >&2; exit 1; }

# The Debian table of layout.md: package, path, source, mode (one line each, tab separated).
rows=$work/rows
awk -F'|' '
	/^## Debian packages/ { on = 1; next }
	/^## / { on = 0 }
	on && NF == 7 && $2 !~ /Package|---/ {
		for (i = 2; i <= 5; i++) { gsub(/^ +| +$/, "", $i) }
		print $2 "\t" $3 "\t" $4 "\t" $5
	}' "$src/docs/designs/layout.md" > "$rows"
[ -s "$rows" ] || { echo "build-deb: no Debian table in docs/designs/layout.md" >&2; exit 1; }

# The pinned microsandbox release, fetched once and checked against the template's two checksums.
msb_files() {
	[ -d "$work/msb" ] && return 0
	sums=$(grep -oE '[0-9a-f]{64}' "$tpl")
	want_tar=$(echo "$sums" | sed -n 1p)
	want_lic=$(echo "$sums" | sed -n 2p)
	home=$(sed -n 's/^homepage="\(.*\)"/\1/p' "$tpl")
	mkdir -p "$work/msb"
	if [ -n "${BOXD_MSB_TARBALL:-}" ]; then cp "$BOXD_MSB_TARBALL" "$work/msb.tar.gz"
	else curl -fsSL -o "$work/msb.tar.gz" "$home/releases/download/v$msbver/microsandbox-linux-x86_64.tar.gz"; fi
	if [ -n "${BOXD_MSB_LICENSE:-}" ]; then cp "$BOXD_MSB_LICENSE" "$work/msb/LICENSE"
	else curl -fsSL -o "$work/msb/LICENSE" "$home/raw/v$msbver/LICENSE"; fi
	[ "$(sha256sum "$work/msb.tar.gz" | cut -d' ' -f1)" = "$want_tar" ] || { echo "build-deb: microsandbox tarball checksum differs from the template" >&2; exit 1; }
	[ "$(sha256sum "$work/msb/LICENSE" | cut -d' ' -f1)" = "$want_lic" ] || { echo "build-deb: microsandbox LICENSE checksum differs from the template" >&2; exit 1; }
	tar -xzf "$work/msb.tar.gz" -C "$work/msb"
}

copyright_text() { # $1 package
	if [ "$1" = microsandbox-bin ]; then
		cat <<EOT
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Upstream-Name: microsandbox
Source: https://github.com/superradcompany/microsandbox

Files: *
Copyright: the microsandbox authors, see LICENSE in this folder
License: Apache-2.0

