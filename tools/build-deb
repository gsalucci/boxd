}

changelog_text() { # $1 package, $2 version
	cat <<EOF
$1 ($2) unstable; urgency=medium

  * Debian package built by tools/build-deb from boxd $ver (see
    docs/packaging-debian.md; upstream changes are in changelog.gz).

 -- boxd maintainers <gsalucci@users.noreply.github.com>  $stamp
EOF
}

build() { # $1 package
	pkg=$1
	case $pkg in microsandbox-bin) pver=$msbver-$rev ;; *) pver=$ver-$rev ;; esac
	stage=$work/stage-$pkg
	rm -rf "$stage"; mkdir -p "$stage/DEBIAN"
	: > "$work/conffiles-$pkg"
	awk -F'\t' -v p="$pkg" '$1 == p' "$rows" > "$work/rows-$pkg"; [ -s "$work/rows-$pkg" ] || { echo "build-deb: no rows for $pkg" >&2; exit 1; }
	while IFS="$(printf '\t')" read -r _ path source mode; do
		path=$(printf %s "$path" | sed "s|@MSB_VERSION@|$msbver|g")
		dest=$stage$path
		case $source in
			dir) install -d -m "$mode" "$dest" ;;
			generated:copyright) install -d "$(dirname "$dest")"; copyright_text "$pkg" > "$dest"; chmod "$mode" "$dest" ;;
			generated:changelog) install -d "$(dirname "$dest")"; changelog_text "$pkg" "$pver" | gzip -9n > "$dest"; chmod "$mode" "$dest" ;;
			generated:upstream-changelog) install -d "$(dirname "$dest")"; gzip -9n < "$src/CHANGELOG.md" > "$dest"; chmod "$mode" "$dest" ;;
			link:*) install -d "$(dirname "$dest")"; ln -s "$(printf %s "${source#link:}" | sed "s|@MSB_VERSION@|$msbver|g")" "$dest" ;;
			download:*)
				msb_files
				f=${source#download:}
				install -d "$(dirname "$dest")"
				if [ "$f" = LICENSE ]; then install -m "$mode" "$work/msb/LICENSE" "$dest"
				else
					found=0
					for g in "$work/msb"/$f; do
						[ -f "$g" ] || continue
						found=1; install -m "$mode" "$g" "$(dirname "$dest")/$(basename "$g")"
					done
					[ "$found" = 1 ] || { echo "build-deb: $f is not in the microsandbox tarball" >&2; exit 1; }
				fi ;;
			*/) install -d "$dest"; cp -R "$src/$source." "$dest/"
				find "$dest" -type d -exec chmod 755 {} +; find "$dest" -type f -exec chmod go-w {} + ;;
			*) [ -f "$src/$source" ] || { echo "build-deb: $source is missing" >&2; exit 1; }
				install -D -m "$mode" "$src/$source" "$dest" ;;
		esac
		case $path in /etc/*) echo "$path" >> "$work/conffiles-$pkg" ;; esac
	done < "$work/rows-$pkg"

	# The packaged settings name the build cgroup that systemd makes for boxd-sshd.service (docs/designs/layout.md).
	if [ -f "$stage/etc/boxd/boxd.conf" ]; then
		sed -i 's|^#BOXD_CGROUP=.*|BOXD_CGROUP=/sys/fs/cgroup/boxd.slice/boxd-sshd.service|' "$stage/etc/boxd/boxd.conf"
		grep -q '^BOXD_CGROUP=/sys/fs/cgroup/boxd.slice/boxd-sshd.service$' "$stage/etc/boxd/boxd.conf" ||
			{ echo "build-deb: boxd.conf has no #BOXD_CGROUP line to enable" >&2; exit 1; }
	fi

	for s in postinst prerm postrm; do
		[ ! -f "$src/debpkgs/$pkg/$s" ] || install -m 755 "$src/debpkgs/$pkg/$s" "$stage/DEBIAN/$s"
	done
	[ ! -s "$work/conffiles-$pkg" ] || install -m 644 "$work/conffiles-$pkg" "$stage/DEBIAN/conffiles"
	find "$stage" -path "$stage/DEBIAN" -prune -o -type f -print0 | sort -z | xargs -0 md5sum | sed "s|  $stage/|  |" > "$stage/DEBIAN/md5sums"
	size=$(du -sk --exclude=DEBIAN "$stage" | cut -f1)
	{ sed -n '1,/^Description:/{/^Description:/!p}' "$src/debpkgs/$pkg/control"
	  echo "Version: $pver"
	  echo "Installed-Size: $size"
	  sed -n '/^Description:/,$p' "$src/debpkgs/$pkg/control"; } > "$stage/DEBIAN/control"
	find "$stage" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +
	arch=$(sed -n 's/^Architecture: //p' "$stage/DEBIAN/control")
	dpkg-deb --root-owner-group -Zxz --build "$stage" "$out/${pkg}_${pver}_${arch}.deb" >/dev/null
	echo "build-deb: $out/${pkg}_${pver}_${arch}.deb"
}

for p in $packages; do build "$p"; done
